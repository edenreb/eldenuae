---
import { ENGINEERS, PROJECTS, YEARS } from "../facts";

const stats = [
  { value: parseInt(PROJECTS), suffix: "+", label: "Projects delivered" },
  { value: YEARS, suffix: "", label: "Years of expertise in the UAE" },
  { value: parseInt(ENGINEERS), suffix: "+", label: "Engineers working on your project" },
];
---

<section class="gutter pb-[120px] md:pb-[200px]">
  <div class="grid grid-cols-1 md:grid-cols-12 md:gap-x-[24px]">
    <div class="grid grid-cols-1 gap-y-[40px] sm:grid-cols-3 sm:gap-x-[24px] md:col-span-9 md:col-start-4">
      {stats.map((stat) => (
        <div>
          <div class="rule" data-reveal-rule></div>
          <p
            class="mt-[24px] font-mono text-[clamp(3.25rem,6.4vw,6.5rem)] leading-none font-medium tracking-[-0.07em] tabular-nums"
            data-count={stat.value}
            data-suffix={stat.suffix}
          >
            0{stat.suffix}
          </p>
          <p class="mt-[16px] text-body text-muted">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Tear down on route change so nodes that never intersected can't
  // accumulate in the observer.
  let observer: IntersectionObserver | null = null;

  function initStatCounters() {
    observer?.disconnect();
    observer = null;

    const nodes = document.querySelectorAll<HTMLElement>("[data-count]");
    if (!nodes.length) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const animate = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      const suffix = el.dataset.suffix ?? "";
      if (reduce) {
        el.textContent = `${target}${suffix}`;
        return;
      }
      const duration = 1400;
      const start = performance.now();
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = `${Math.round(target * eased)}${suffix}`;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };

    observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            observer?.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.6 },
    );

    nodes.forEach((node) => observer?.observe(node));
  }

  document.addEventListener("astro:page-load", initStatCounters);
  document.addEventListener("astro:before-swap", () => {
    observer?.disconnect();
    observer = null;
  });
</script>
