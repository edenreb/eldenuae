---
// Outlined square button — a frame, not a block. Hover floods it with its
// own line colour while the label rolls up and a duplicate rolls in from
// below. CSS-only; both copies carry the same text so the accessible name
// never changes mid-transition.
interface Props {
  href: string;
  label: string;
  // "ink" on paper surfaces, "paper" over photography and dark bands.
  tone?: "ink" | "paper";
  class?: string;
  // Caller knows `href` is the current page: reload instead of replaying
  // the page transition.
  reload?: boolean;
}
const { href, label, tone = "ink", class: className = "", reload = false } = Astro.props;
---

<a
  href={href}
  data-astro-reload={reload ? true : undefined}
  class:list={[
    "group relative inline-flex h-[48px] cursor-pointer items-center border px-[20px] text-label uppercase transition-colors duration-300",
    tone === "ink"
      ? "border-ink text-ink hover:bg-ink hover:text-paper"
      : "border-paper text-paper hover:bg-paper hover:text-ink",
    className,
  ]}
>
  <span class="relative block overflow-hidden">
    <span class="block transition-transform duration-300 ease-out group-hover:-translate-y-full">{label}</span>
    <span aria-hidden="true" class="absolute inset-0 block translate-y-full transition-transform duration-300 ease-out group-hover:translate-y-0">
      {label}
    </span>
  </span>
</a>
