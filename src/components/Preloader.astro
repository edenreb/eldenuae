---
// Session-scoped entry sequence: the wordmark holds the centre of the screen
// while a progress bar fills along the bottom edge, its counter running to
// 100. (An earlier version stopped the count at 87 — Elden's project count —
// but that reads as a stalled/broken loader rather than a deliberate number;
// a preloader counter is expected to reach 100.)
//
// It does not touch the hero. When the curtain clears it dispatches
// `elden:intro`; the hero owns its own reveal and listens for that. When the
// preloader is skipped the event fires immediately, so the hero behaves the
// same either way.
//
// Whether it plays at all is decided by the inline head script in
// Base.astro, before first paint — see the comment there. This component
// only reads the resulting `data-preloading` flag; it never re-decides, or
// the two could disagree.
//
// Accessibility contract:
//   - display:none unless <html data-preloading> is set, so no-JS and
//     reduced-motion users never see a stuck cream screen
//   - contains nothing focusable, so it cannot trap the keyboard
//   - aria-hidden: decoration over content that is already in the DOM
import logoSrc from "../assets/logo.svg";
---

<div
  id="preloader"
  aria-hidden="true"
  class="fixed inset-0 overflow-hidden"
  style="z-index: var(--z-preloader)"
>
  <!-- The panel is two halves rather than one sheet, so the intro ends by
       opening the page rather than sliding off it. They carry the ink fill;
       the wrapper above is transparent, or there would be nothing to open.
       Each is 50.5% tall so they overlap across the seam — at exactly 50%
       an odd viewport height leaves a one-pixel line of the page showing
       through the middle for the whole load. -->
  <div id="preloader-top" class="absolute inset-x-0 top-0 h-[50.5%] bg-ink"></div>
  <div id="preloader-bottom" class="absolute inset-x-0 bottom-0 h-[50.5%] bg-ink"></div>

  <!-- Centring wrapper rather than a translate on the image itself: the exit
       animates the mark's own transform, and a Tailwind `-translate-*` on the
       same element would be the thing GSAP overwrites. -->
  <div class="absolute inset-0 flex items-center justify-center">
    <img
      id="preloader-mark"
      src={logoSrc.src}
      alt=""
      fetchpriority="high"
      class="h-[32px] w-auto md:h-[44px]"
    />
  </div>

  <div
    id="preloader-foot"
    class="absolute inset-x-0 bottom-0 px-[24px] pb-[24px] md:px-[32px] md:pb-[32px]"
  >
    <p
      id="preloader-count"
      class="mb-[16px] tabular-nums text-heading leading-none text-cream"
    >
      00
    </p>
    <!-- `.rule` is the site's 2px/10%-white hairline utility — the same
         divider used across the page, reused here as the bar's unfilled
         track rather than a one-off border. -->
    <div id="preloader-track" class="rule overflow-hidden">
      <div id="preloader-fill" class="h-full w-full bg-cream"></div>
    </div>
  </div>
</div>

<style>
  /* Painted from the very first frame when the head script says the intro
     is playing, and never rendered at all otherwise. This is what replaced
     the `hidden` attribute: `hidden` could only be cleared from JS running
     after paint, which is exactly the flash we were trying to avoid. */
  #preloader {
    display: none;
  }
  :global(html[data-preloading]) #preloader {
    display: block;
  }

  /* Start empty, and grow from the left. Declared here rather than left to
     GSAP's first frame: the bar is painted before the script runs, and a
     full-width cream bar flashing for one frame is the whole thing this
     preloader exists to avoid. */
  #preloader-fill {
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* The bar thickens in place on the way to 100, so it grows upward off the
     baseline instead of straddling it. */
  #preloader-track {
    transform-origin: center bottom;
  }
</style>

<script>
  import gsap from "gsap";

  const SEEN_KEY = "elden:preloaded";
  // A literal rgb() rather than the CSS var: GSAP's color interpolator
  // numerically lerps between two resolved colors and can't resolve a var()
  // reference itself, only getComputedStyle can — so the token's value is
  // duplicated here rather than referenced. Keep in sync with
  // --color-brand-green if the brand green ever changes.
  const BRAND_GREEN = "rgb(73, 155, 86)";

  function initPreloader() {
    const el = document.getElementById("preloader");
    if (!el) return;

    // A flag as well as an event: the hero may subscribe after this fires
    // (it waits for tab visibility), so it needs to be able to ask "did the
    // intro already happen?" rather than relying on catching the event live.
    const announce = () => {
      document.documentElement.dataset.introReady = "1";
      document.dispatchEvent(new CustomEvent("elden:intro"));
    };
    // Releases the scroll lock. Idempotent — the wipe and the watchdog can
    // both reach it.
    const unlock = () => delete document.documentElement.dataset.preloading;

    // Whether to play was already settled before first paint by the inline
    // head script in Base.astro (once per session, never under reduced
    // motion, never in a backgrounded tab — rAF is throttled to zero there,
    // so the curtain would never lift and the cream screen would block the
    // page indefinitely). Just read its verdict.
    if (!document.documentElement.dataset.preloading) {
      el.remove();
      // Deferred a frame: astro:page-load listeners fire in registration
      // order, and the hero may not have subscribed to elden:intro yet.
      requestAnimationFrame(announce);
      return;
    }

    try {
      sessionStorage.setItem(SEEN_KEY, "1");
    } catch (e) {
      /* Private modes throw on write. Worst case the intro replays on the
         next navigation — not worth failing the page over. */
    }

    const counter = document.getElementById("preloader-count");
    const mark = document.getElementById("preloader-mark");
    const track = document.getElementById("preloader-track");
    const halves = [document.getElementById("preloader-top"), document.getElementById("preloader-bottom")];
    const fill = document.getElementById("preloader-fill");
    const value = { n: 0 };

    // Insurance: whatever happens to the timeline (tab backgrounded mid-run,
    // GSAP stalling), the curtain is gone and the page usable after 5s.
    const watchdog = setTimeout(() => {
      announce();
      unlock();
      el.remove();
    }, 5000);

    gsap
      .timeline()
      // Load. The counter, the bar and the site's one signature brand-color
      // moment (cream tinting to brand green) all run off the same 1.25s —
      // three readings of a single progress value, not three animations.
      // Green and not navy: navy measures 1.7:1 on this bg-ink canvas, below
      // even the 3:1 non-text minimum, so it would just be invisible here.
      .to(value, {
        n: 100,
        duration: 1.2,
        ease: "power2.inOut",
        onUpdate: () => {
          if (counter) counter.textContent = String(Math.round(value.n)).padStart(2, "0");
        },
      })
      .to(fill, { scaleX: 1, duration: 1.2, ease: "power2.inOut" }, "<")
      .to(counter, { color: BRAND_GREEN, duration: 1.2, ease: "power2.inOut" }, "<")

      // Arrival at 100. The bar flushes green and swells off its baseline,
      // then settles — a beat that acknowledges the number instead of
      // cutting straight from counting to gone.
      .to(fill, { backgroundColor: BRAND_GREEN, duration: 0.18, ease: "power2.out" })
      .to(track, { scaleY: 4, duration: 0.18, ease: "power2.out" }, "<")
      .to(track, { scaleY: 1, duration: 0.28, ease: "power2.inOut" }, "+=0.05")

      // Exit, staged so the furniture leaves before the panel does. The bar
      // empties the way it filled — left edge chasing the right — rather
      // than fading, so the load reads as completing rather than stopping.
      .set(fill, { transformOrigin: "right center" })
      .to(fill, { scaleX: 0, duration: 0.45, ease: "power3.inOut" }, "-=0.1")
      .to(counter, { y: 28, autoAlpha: 0, duration: 0.4, ease: "power2.in" }, "<")

      // The mark has to be gone before the halves part, not riding them —
      // it sits dead on the seam, so anything still visible there gets torn
      // down the middle. Hence no overlap worth speaking of below.
      .to(mark, { scale: 1.14, autoAlpha: 0, duration: 0.45, ease: "power2.in" }, "-=0.25")

      // The open. Two halves clearing in opposite directions rather than one
      // sheet sliding off: the page is revealed from the centre outward,
      // which is the point of splitting it at all.
      //
      // power3.inOut and not the accelerate-away curve used for panels that
      // are merely getting out of the way — here the movement IS the reveal,
      // so it earns a settle at the end instead of being rushed off.
      .to(
        halves[0],
        {
          yPercent: -100,
          duration: 0.85,
          ease: "power3.inOut",
          onStart: () => {
            announce(); // hero reveal rides the opening, not after it
            unlock(); // and the page is scrollable again as it parts
          },
          onComplete: () => {
            clearTimeout(watchdog);
            el.remove();
          },
        },
        "-=0.05",
      )
      .to(halves[1], { yPercent: 100, duration: 0.85, ease: "power3.inOut" }, "<");
  }

  document.addEventListener("astro:page-load", initPreloader);
</script>
