      <path fill="#38c467" stroke="#38c467" d="M 387.27 53.31 C 419.19 53.07 451.14 53.36 483.07 53.08 C 486.47 52.74 489.57 55.27 490.63 58.37 C 491.59 62.38 488.40 67.16 484.01 66.64 C 451.79 66.35 419.57 66.86 387.36 66.51 C 380.41 65.88 380.35 54.15 387.27 53.31 Z"></path>
      <path fill="#ffffff" stroke="#ffffff" d="M 608.25 3.44 C 611.47 2.46 615.76 4.11 616.35 7.73 C 617.31 12.42 616.73 17.25 616.88 22.00 C 616.82 32.69 617.03 43.40 616.69 54.09 C 616.59 60.37 611.59 66.57 605.09 66.81 C 600.32 67.78 596.46 64.48 592.63 62.28 C 581.54 54.27 569.68 47.38 558.43 39.61 C 552.15 35.13 545.29 31.52 539.22 26.74 C 535.56 24.49 531.96 22.04 527.98 20.41 C 525.40 20.03 524.89 23.08 524.90 24.97 C 524.59 36.29 524.99 47.64 524.70 58.97 C 524.48 61.02 524.55 63.46 522.85 64.93 C 520.19 67.62 514.89 67.46 512.82 64.12 C 511.04 61.79 511.51 58.72 511.41 55.99 C 511.44 43.12 511.27 30.25 511.51 17.38 C 511.48 11.84 514.55 5.84 520.02 3.99 C 523.14 3.10 526.67 2.98 529.69 4.31 C 542.54 11.47 554.09 20.68 566.57 28.45 C 573.65 33.00 580.45 37.99 587.73 42.24 C 592.17 44.74 595.78 48.99 600.99 49.91 C 603.26 49.02 603.17 46.10 603.43 44.06 C 603.52 33.03 603.58 22.00 603.48 10.97 C 603.21 7.77 605.11 4.41 608.25 3.44 Z"></path>
    </svg>
  </div>

  <div
    id="preloader-foot"
    class="absolute inset-x-0 bottom-0 px-[24px] pb-[24px] md:px-[32px] md:pb-[32px]"
  >
    <!-- `.rule` is the site's 2px/10%-white hairline utility — the same
         divider used across the page, reused here as the bar's unfilled
         track rather than a one-off border. The counter used to sit in
         flow above the track; it's a positioned sibling now so its `left`
         can be driven by the same progress value as the fill, riding the
         fill's own leading edge instead of sitting fixed at the start of
         the line. overflow-hidden and the arrival scaleY both live on a
         wrapper INSIDE the track, not the track itself: the counter is
         also a child of the track (its `left` is a percentage of the same
         box the fill's width is), and a transform scales everything
         painted inside the element it's on — putting the thickening
         scaleY on the track would stretch the counter's digits right
         along with the bar for that beat. Scaling only the inner wrapper
         thickens the fill/rule alone and leaves the counter untouched. -->
    <div id="preloader-track" class="relative rule">
      <div id="preloader-bar" class="h-full w-full overflow-hidden">
        <div id="preloader-fill" class="h-full w-full bg-cream"></div>
      </div>
      <p
        id="preloader-count"
        class="absolute bottom-[calc(100%+16px)] left-0 tabular-nums text-heading leading-none text-cream"
      >
        00
      </p>
    </div>
  </div>
</div>

<style>
  /* Painted from the very first frame when the head script says the intro
     is playing, and never rendered at all otherwise. This is what replaced
     the `hidden` attribute: `hidden` could only be cleared from JS running
     after paint, which is exactly the flash we were trying to avoid.

     This rule's job ends once the script below takes over: initPreloader
     sets #preloader's display directly as soon as it commits to running
     the real sequence, so the panel's visibility for the rest of its life
     is owned by JS, not by this flag. It has to be — data-preloading also
     drives the scroll lock (see global.css) and gets cleared deliberately
     early, mid-exit, so the page is scrollable again as the mark fades.
     An earlier version let this same rule keep gating #preloader too, so
     clearing the flag didn't just unlock scroll — it also matched this
     selector out of existence and cut #preloader to display:none on the
     same frame, instantly, before its fade-out tween had played a single
     visible frame. One flag, two lifecycles that only looked like one. */
  #preloader {
    display: none;
  }
  :global(html[data-preloading]) #preloader {
    display: block;
  }

  /* Large safe default, well past any real letterform's traced length —
     guarantees every path starts fully hidden (offset === array length)
     before the script computes each one's exact length via
     getTotalLength() and overwrites both numbers together. Because offset
     and array move in lockstep, the overwrite doesn't change what's on
     screen (still 0% drawn either way), so there's no flash when it
     happens; the JS values are only more precise, not different in kind. */
  #preloader-mark path {
    fill-opacity: 0;
    stroke-width: 2;
    stroke-dasharray: 2000;
    stroke-dashoffset: 2000;
    vector-effect: non-scaling-stroke;
  }

  /* Start empty, and grow from the left. Declared here rather than left to
     GSAP's first frame: the bar is painted before the script runs, and a
     full-width cream bar flashing for one frame is the whole thing this is
     built to avoid. */
  #preloader-fill {
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* The bar thickens in place on arrival at 100, so it grows upward off the
     baseline instead of straddling it. Scales #preloader-bar, not
     #preloader-track — see the markup comment above for why. */
  #preloader-bar {
    transform-origin: center bottom;
  }
</style>

<script>
  import gsap from "gsap";

  const SEEN_KEY = "elden:preloaded";
  // A literal rgb() rather than the CSS var: GSAP's color interpolator
  // numerically lerps between two resolved colors and can't resolve a var()
  // reference itself, only getComputedStyle can — so the token's value is
  // duplicated here rather than referenced. Keep in sync with
  // --color-brand-green if the brand green ever changes.
  const BRAND_GREEN = "rgb(73, 155, 86)";

  function initPreloader() {
    const el = document.getElementById("preloader");
    if (!el) return;

    // A flag as well as an event: the hero may subscribe after this fires
    // (it waits for tab visibility), so it needs to be able to ask "did the
    // intro already happen?" rather than relying on catching the event live.
    const announce = () => {
      document.documentElement.dataset.introReady = "1";
      document.dispatchEvent(new CustomEvent("elden:intro"));
    };
    // Releases the scroll lock. Idempotent — the watchdog and the real
    // sequence can both reach it.
    const unlock = () => delete document.documentElement.dataset.preloading;

    // Whether to play was already settled before first paint by the inline
    // head script in Base.astro (once per session, never under reduced
    // motion, never in a backgrounded tab — rAF is throttled to zero there,
    // so the mark would never finish drawing and the ink screen would block
    // the page indefinitely). Just read its verdict.
    if (!document.documentElement.dataset.preloading) {
      el.remove();
      // Deferred a frame: astro:page-load listeners fire in registration
      // order, and the hero may not have subscribed to elden:intro yet.
      requestAnimationFrame(announce);
      return;
    }

    // From here on #preloader's own visibility is owned by this script, not
    // by the data-preloading flag — see the long comment on the CSS rule
    // above for why that split matters.
    el.style.display = "block";

    try {
      sessionStorage.setItem(SEEN_KEY, "1");
    } catch (e) {
      /* Private modes throw on write. Worst case the intro replays on the
         next navigation — not worth failing the page over. */
    }

    const mark = document.getElementById("preloader-mark");
    const paths = mark ? [...mark.querySelectorAll("path")] : [];
    const counter = document.getElementById("preloader-count");
    const track = document.getElementById("preloader-track");
    const bar = document.getElementById("preloader-bar");
    const fill = document.getElementById("preloader-fill");
    const value = { n: 0 };

    // Insurance: whatever happens to the timeline (tab backgrounded mid-run,
    // GSAP stalling), the preloader is gone and the page usable after 8s.
    const watchdog = setTimeout(() => {
      announce();
      unlock();
      el.remove();
    }, 8000);

    if (!paths.length) {
      // Defensive: nothing to draw. Behave like the no-preload path above
      // rather than sit on an empty timeline waiting on the watchdog.
      clearTimeout(watchdog);
      announce();
      unlock();
      el.remove();
      return;
    }

    // Each path's own traced length, not the CSS fallback's round number —
    // keeps the draw speed visually even across letterforms of very
    // different length (one bar of an "E" vs. the full outline of the "D",
    // holes included).
    paths.forEach((p) => {
      const len = p.getTotalLength();
      gsap.set(p, { strokeDasharray: len, strokeDashoffset: len });
    });

    // Centres the counter over its own `left` position via GSAP's own
    // xPercent, not a raw inline `transform: translateX(-50%)` — the exit
    // below animates this same element's `y`, and GSAP owns the whole
    // `transform` property once it touches any part of it. A transform it
    // didn't set itself wouldn't survive that later write; xPercent is
    // GSAP's supported way to bake in a permanent "percent of my own size"
    // offset that composes correctly with whatever else gets animated on
    // top of it (same idiom Cursor.astro uses for its centred dot/pill).
    if (counter) gsap.set(counter, { xPercent: -50 });

    // The counter is centred on its own `left` point, so at 0% and 100% it
    // would hang half its width off each end of the track. Clamp `left` in
    // pixels to keep the whole box inside the line. Half-width is measured
    // at the WIDEST real content ("100"), read once here — swap it in, read,
    // put "00" back, all before any paint.
    const trackWidth = track ? track.getBoundingClientRect().width : 0;
    let counterHalfWidth = 0;
    if (counter) {
      counter.textContent = "100";
      counterHalfWidth = counter.getBoundingClientRect().width / 2;
      counter.textContent = "00";
    }
    const counterMinX = counterHalfWidth;
    const counterMaxX = Math.max(trackWidth - counterHalfWidth, counterHalfWidth);

    // Per-path draw duration and the left-to-right stagger between them.
    // DRAW_TOTAL is how long the full sequence of paths takes to finish
    // drawing, tail included — that's also how long the counter and bar
    // run for, since they're timing the same event, not a separate one.
    const DRAW_S = 1.6;
    const STAGGER_S = 0.14;
    const DRAW_TOTAL = (paths.length - 1) * STAGGER_S + DRAW_S;
    const FILL_S = 0.7;

    gsap
      .timeline()
      // Draw, count, and fill the bar together — three readings of one
      // progress value, not three animations that happen to agree. The
      // paths are already in reading order in the markup (E, L, D, E, N),
      // so a plain left-to-right stagger is what makes the draw read as the
      // word being written rather than nine shapes resolving at once.
      .to(
        paths,
        { strokeDashoffset: 0, duration: DRAW_S, stagger: STAGGER_S, ease: "power2.inOut" },
        0,
      )
      .to(
        value,
        {
          n: 100,
          duration: DRAW_TOTAL,
          ease: "power2.inOut",
          onUpdate: () => {
            if (!counter) return;
            counter.textContent = String(Math.round(value.n)).padStart(2, "0");
            // Rides the fill's own leading edge: the raw target is a plain
            // percentage of the track's width, the same width the fill's
            // scaleX is a fraction of, so the two stay lined up. Then
            // clamped into pixels so the counter's own box — not just its
            // centre — never crosses either end of the track.
            const raw = (value.n / 100) * trackWidth;
            counter.style.left = `${Math.min(Math.max(raw, counterMinX), counterMaxX)}px`;
          },
        },
        0,
      )
      .to(fill, { scaleX: 1, duration: DRAW_TOTAL, ease: "power2.inOut" }, 0)

      // Ink fills in behind the completed outline rather than the drawing
      // cutting straight to solid — the crossfade is what makes it read as
      // the same mark gaining weight, not a swap to a different asset.
      .to(paths, { fillOpacity: 1, duration: FILL_S, ease: "power2.out" }, "-=0.38")
      .to(paths, { strokeOpacity: 0, duration: FILL_S, ease: "power2.out" }, "<")

      // Arrival at 100. The bar flushes green and swells off its baseline,
      // the counter tints to match — a beat that acknowledges the number
      // instead of cutting straight from counting to gone.
      .to(fill, { backgroundColor: BRAND_GREEN, duration: 0.3, ease: "power2.out" })
      .to(counter, { color: BRAND_GREEN, duration: 0.3, ease: "power2.out" }, "<")
      .to(bar, { scaleY: 4, duration: 0.3, ease: "power2.out" }, "<")
      .to(bar, { scaleY: 1, duration: 0.45, ease: "power2.inOut" }, "+=0.08")

      // Hold, then out. The mark and the bar leave the same way they
      // arrived — as themselves, fading and settling back — rather than
      // introducing new geometry (a splitting panel, a sliding curtain)
      // for the exit alone that has nothing to do with what was just drawn.
      .to({}, { duration: 0.4 })
      .set(fill, { transformOrigin: "right center" })
      .to(fill, { scaleX: 0, duration: 0.85, ease: "power3.inOut" }, "-=0.15")
      .to(counter, { y: 28, autoAlpha: 0, duration: 0.8, ease: "power2.in" }, "<")
      .to(mark, { scale: 0.94, autoAlpha: 0, duration: 0.95, ease: "power2.in" }, "-=0.38")
      .to(
        el,
        {
          autoAlpha: 0,
          duration: 1,
          ease: "power2.in",
          onStart: () => {
            announce(); // hero reveal rides the fade, not after it
            unlock(); // and the page is scrollable again as it clears
          },
          onComplete: () => {
            clearTimeout(watchdog);
            el.remove();
          },
        },
        "-=0.45",
      );
  }

  document.addEventListener("astro:page-load", initPreloader);
</script>
