---
// Studio statement — label in the left margin, one large paragraph filling
// the rest of the row, brightening word by word as it scrolls through.
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";
---

<section class="gutter pt-[120px] pb-[72px] md:pt-[200px] md:pb-[112px]">
  <div class="grid grid-cols-1 gap-y-[28px] md:grid-cols-12 md:gap-x-[24px]">
    <div class="md:col-span-3">
      <Eyebrow>Studio</Eyebrow>
    </div>
    <div class="md:col-span-9">
      <p class="max-w-[32ch] text-statement" data-scroll-words>
        Elden is a top-tier interior fitout studio based in Dubai. We consistently deliver projects of
        the highest quality. We're one turnkey studio that takes your project from sketch to
        opening day, across fitness, F&amp;B, retail, workplace, and hospitality throughout the UAE.
      </p>
      <div class="mt-[40px] grid grid-cols-1 gap-[28px] md:grid-cols-9 md:gap-x-[24px]">
        <p class="max-w-[46ch] text-body text-muted md:col-span-5">
          Our vision is to become the customer's first choice and a benchmark company in providing quality interior
          design and fitout services across the region.
        </p>
        <div class="md:col-span-4 md:justify-self-end md:self-end">
          <Button href="/about" label="About the studio" />
        </div>
      </div>
    </div>
  </div>
</section>
