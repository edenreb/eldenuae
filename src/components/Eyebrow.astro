---
// Section label: a small brand-green square, then mono uppercase text.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<p class:list={["meta flex items-center gap-[10px]", className]} data-rise="16">
  <span aria-hidden="true" class="h-[7px] w-[7px] shrink-0 bg-brand"></span>
  <slot />
</p>
