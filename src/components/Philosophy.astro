---
// Mission — a narrow image column on the left, the statement filling the
// row. On md+ the row pins while the image stack drifts up inside its
// clipped column; pin and drift share one ScrollTrigger, so their durations
// are the same number by construction. Without JS, or under reduced motion,
// it is a plain static row.
import { Picture } from "astro:assets";
import img1 from "../assets/anantara-penthouse/4.jpg";
import img2 from "../assets/tbk-galleria/1.jpg";
import img3 from "../assets/beiruti/6.jpg";
import img4 from "../assets/whgym-difc/3.jpg";
import img5 from "../assets/equities-first/1.jpg";
import img6 from "../assets/voco-by-ihg/1.jpg";
import img7 from "../assets/voco-by-ihg/2.jpg";
import img8 from "../assets/voco-by-ihg/3.jpg";
import Eyebrow from "./Eyebrow.astro";

// Any number of images works — travel is measured at runtime.
const images = [img1, img2, img3, img4, img5, img6, img7, img8];

const LEAD = "To support our vision by:";
const TEXT =
  "Realising our clients' visions through the most functional, sustainable and innovative interior solutions. Providing and maintaining creative professional excellence, exceptional customer service, and quantifiable results.";
---

<section id="philosophy" class="gutter border-t border-paper/15 py-[96px] md:py-0">
  <div
    id="philosophy-row"
    class="flex flex-col gap-[32px] md:h-screen md:flex-row md:items-center md:gap-[96px] md:pt-[calc(var(--header-h)+48px)] md:pb-[48px]"
  >
    <!-- Hidden below md: without the pin it would be eight stacked photos. -->
    <div class="hidden overflow-hidden md:block md:h-full md:w-[300px] md:shrink-0">
      <div id="philosophy-stack" class="flex flex-col gap-[16px]">
        {images.map((img, i) => (
          <div class="aspect-[3/4] w-full shrink-0 overflow-hidden bg-ink">
            <Picture
              src={img}
              alt=""
              formats={["avif", "webp"]}
              widths={[400, 700]}
              sizes="300px"
              loading={i === 0 ? "eager" : "lazy"}
              class="h-full w-full object-cover"
            />
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-col gap-[24px] md:flex-1">
      <div class="h-[2px] w-full bg-[rgb(73_155_86)]" data-reveal-rule></div>
      <Eyebrow>Our Mission</Eyebrow>
      <p class="text-body text-muted">{LEAD}</p>
      <p class="max-w-[34ch] text-statement" data-reveal-words>
        {TEXT}
      </p>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { whenVisible } from "../scripts/motion";

  gsap.registerPlugin(ScrollTrigger);

  function initPhilosophyStack() {
    const row = document.getElementById("philosophy-row");
    const stack = document.getElementById("philosophy-stack");
    if (!row || !stack) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!window.matchMedia("(min-width: 768px)").matches) return;

    whenVisible(() => {
      // Travel exactly the stack's overflow, so the last image lands flush
      // with the bottom of the column as the pin releases.
      const travel = stack.scrollHeight - stack.parentElement!.clientHeight;
      if (travel <= 0) return;

      gsap.to(stack, {
        y: -travel,
        ease: "none",
        scrollTrigger: {
          trigger: row,
          start: "top top",
          end: () => `+=${travel}`,
          scrub: true,
          pin: row,
        },
      });
    });
  }

  document.addEventListener("astro:page-load", initPhilosophyStack);
</script>
