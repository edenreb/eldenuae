---
// Instagram + LinkedIn, real URLs supplied directly.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;

const social = [
  { href: "https://www.instagram.com/eldenuae/", label: "Instagram" },
  { href: "https://www.linkedin.com/company/elden-uae/", label: "LinkedIn" },
];
---

<ul class:list={["flex flex-col gap-[8px]", className]}>
  {social.map((s) => (
    <li>
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        class="cursor-pointer underline-offset-4 hover:underline"
      >
        {s.label} <span aria-hidden="true">&#8599;</span>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </li>
  ))}
</ul>
