---
// Photo + name + quote reads as genuine testimony. Before launch, every one
// of these must be a real, sourced quote the named client actually gave.
import { Image } from "astro:assets";
import Eyebrow from "./Eyebrow.astro";
import pankaj from "../assets/testimonials/pankaj-agarwal.jpg";
import kevin from "../assets/testimonials/kevin-teixeira.jpg";
import amit from "../assets/testimonials/amit-choubey.jpg";

const quotes = [
  {
    body: "The professionalism with which the work was Elden engineers is worth mentioning often.",
    name: "Pankaj Agarwal",
    role: "Managing Director, Bikanervala Chain of Restaurants",
    photo: pankaj,
  },
  {
    body: "Elden's attentional to detail is what keeps them above the rest.",
    name: "Kevin Teixeira",
    role: "Managing Director, Warehouse Gym",
    photo: kevin,
  },
  {
    body: "The design drawings and specifications were followed with precision. Would love to collaborate again in the future.",
    name: "Amit Choubey",
    role: "Head of Projects, SRG Properties LLC",
    photo: amit,
  },
];
---

<section class="gutter py-[120px] md:py-[200px]">
  <div>
    <Eyebrow>Testimonials</Eyebrow>
    <h2 class="mt-[20px] text-heading" data-reveal-words>What Clients Say</h2>
  </div>

  <div class="mt-[56px] grid grid-cols-1 gap-y-[64px] md:mt-[112px] md:grid-cols-3 md:gap-x-[24px]">
    {
      quotes.map((q, i) => (
        <blockquote class="flex flex-col">
          <div class="rule" data-reveal-rule></div>
          <div class="mt-[16px] flex items-center justify-between gap-[16px]">
            {/* Static 5/5 — no rating was ever collected from these clients;
                presentation, not sourced data. Confirm before launch or drop it. */}
            <p class="text-body leading-none tracking-[0.2em] text-[#d9a531]" aria-label="Rated 5 out of 5">
              <span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            </p>
            <p class="meta text-muted">({String(i + 1).padStart(2, "0")})</p>
          </div>
          <p class="mt-[28px] max-w-[26ch] text-lead">&ldquo;{q.body}&rdquo;</p>
          <footer class="mt-[36px] flex items-center gap-[14px] md:mt-auto md:pt-[48px]">
            <Image
              src={q.photo}
              alt=""
              width={96}
              height={96}
              class="h-[48px] w-[48px] shrink-0 object-cover"
              style="border-radius: 999px;"
            />
            <div>
              <p class="text-label uppercase">{q.name}</p>
              <p class="meta mt-[6px] text-muted">{q.role}</p>
            </div>
          </footer>
        </blockquote>
      ))
    }
  </div>
</section>
