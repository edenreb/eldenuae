---
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";
import Logo from "./Logo.astro";
import SocialLinks from "./SocialLinks.astro";

const year = new Date().getFullYear();

// Strict same-page match (trailing slash stripped — Astro.url.pathname
// carries one on static routes): a footer link to the current page reloads
// instead of replaying the transition.
const path = Astro.url.pathname.replace(/(.)\/$/, "$1");
const isSamePage = (href: string) => path === href;

const pages = [
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/journal", label: "Journal" },
  { href: "/careers", label: "Careers" },
  { href: "/contact", label: "Contact" },
];
---

<footer class="overflow-hidden bg-ink text-paper">
  <div class="gutter pt-[120px] md:pt-[200px]">
    <Eyebrow>Contact</Eyebrow>
    <h2 class="mt-[28px] text-display uppercase">
      Have a space<br />in mind? <em class="accent">Let's talk.</em>
    </h2>
    <div class="mt-[40px] flex flex-wrap items-center gap-x-[32px] gap-y-[20px] md:mt-[56px]">
      <Button href="/contact" label="Start a project" tone="paper" reload={isSamePage("/contact")} />
      <a href="mailto:info@eldenuae.com" class="cursor-pointer text-lead underline-offset-[6px] hover:underline">
        info@eldenuae.com
      </a>
    </div>

    <div class="rule mt-[96px] md:mt-[160px]"></div>

    <div class="grid grid-cols-2 gap-x-[24px] gap-y-[40px] py-[40px] md:grid-cols-12 md:py-[56px]">
      <p class="col-span-2 max-w-[30ch] text-body text-mist md:col-span-4">
        Turnkey interior design and fit-out for the UAE&rsquo;s fitness, F&amp;B, retail, workplace and hospitality
        brands.
      </p>

      <div class="md:col-span-2 md:col-start-7">
        <p class="meta text-mist">Pages</p>
        <ul class="mt-[16px] flex flex-col gap-[8px]">
          {pages.map((link) => (
            <li>
              <a
                href={link.href}
                data-astro-reload={isSamePage(link.href) ? true : undefined}
                class="cursor-pointer underline-offset-4 hover:underline"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="meta text-mist">Connect</p>
        <SocialLinks class="mt-[16px]" />
      </div>

      <div class="col-span-2 md:col-span-2">
        <p class="meta text-mist">Visit</p>
        <ul class="mt-[16px] flex flex-col gap-[8px]">
          <li>Dubai, United Arab Emirates</li>
          <li><a href="tel:+97142276206" class="cursor-pointer underline-offset-4 hover:underline">+971 4 227 6206</a></li>
          <li><a href="mailto:info@eldenuae.com" class="cursor-pointer underline-offset-4 hover:underline">info@eldenuae.com</a></li>
        </ul>
      </div>
    </div>

    <div class="meta flex flex-col gap-[8px] pb-[24px] text-mist md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} Elden Interiors LLC</p>
      <p class="flex gap-[20px]">
        <a href="/privacy" data-astro-reload={isSamePage("/privacy") ? true : undefined} class="cursor-pointer hover:text-paper">Privacy</a>
        <a href="/terms" data-astro-reload={isSamePage("/terms") ? true : undefined} class="cursor-pointer hover:text-paper">Terms</a>
      </p>
    </div>
  </div>

  <!-- The wordmark at full width, cut off by the page's bottom edge. -->
  <div class="gutter" aria-hidden="true">
    <Logo class="block h-auto w-full translate-y-[18%]" />
  </div>
</footer>
