---
// Six featured projects on a staggered 12-column grid — landscape and
// portrait frames alternating sides, the right-hand frame of each pair
// dropped below its partner. One layout for every input device: nothing
// here depends on hover to be understood.
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Button from "./Button.astro";
import Eyebrow from "./Eyebrow.astro";

const all = await getCollection("projects");
const projects = all
  .filter((p) => p.data.featured || p.data.tier === "hero")
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 6);

// Desktop placement per slot. Pairs share a row: (0,1) (2,3) (4,5).
const layout = [
  { col: "md:col-span-7", frame: "md:aspect-[4/3]" },
  { col: "md:col-span-4 md:col-start-9 md:mt-[200px]", frame: "md:aspect-[3/4]" },
  { col: "md:col-span-4 md:col-start-2", frame: "md:aspect-[3/4]" },
  { col: "md:col-span-6 md:col-start-7 md:mt-[260px]", frame: "md:aspect-[4/3]" },
  { col: "md:col-span-6", frame: "md:aspect-[4/3]" },
  { col: "md:col-span-4 md:col-start-9 md:mt-[180px]", frame: "md:aspect-[3/4]" },
];
---

<section class="gutter pb-[120px] md:pb-[200px]">
  <div class="flex flex-col gap-[24px] md:flex-row md:items-end md:justify-between">
    <div>
      <Eyebrow>Projects</Eyebrow>
      <h2 class="mt-[20px] text-heading uppercase" data-reveal-words>Selected work</h2>
    </div>
    <p class="max-w-[34ch] text-body text-muted md:text-right">
      Recent fitouts across the UAE — designed, built and handed over by one team.
    </p>
  </div>

  <div class="mt-[56px] grid grid-cols-1 gap-y-[56px] md:mt-[112px] md:grid-cols-12 md:gap-x-[24px] md:gap-y-[128px]">
    {
      projects.map((project, i) => (
        <a href={`/projects/${project.id}`} data-cursor="open" class:list={["group block cursor-pointer", layout[i].col]}>
          <div class:list={["aspect-[4/3] overflow-hidden bg-ink", layout[i].frame]} data-reveal>
            <Picture
              src={project.data.cover}
              alt={`${project.data.title} — ${project.data.sector.toLowerCase()} fitout by Elden`}
              formats={["avif", "webp"]}
              widths={[600, 900, 1300]}
              sizes="(min-width: 768px) 55vw, 100vw"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.2,0.7,0.2,1)] group-hover:scale-[1.04]"
            />
          </div>
          <div class="mt-[16px] flex items-baseline justify-between gap-[16px]">
            <h3 class="text-title uppercase">{project.data.title}</h3>
            <span class="meta shrink-0 text-muted">{project.data.year}</span>
          </div>
          <p class="meta mt-[8px] text-muted">
            {project.data.sector} — {project.data.location}
          </p>
        </a>
      ))
    }
  </div>

  <div class="mt-[80px] flex justify-center md:mt-[140px]">
    <Button href="/projects" label={`View all projects (${all.length})`} />
  </div>
</section>
