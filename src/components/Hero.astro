---
// Full-bleed photographic hero. One image, one centred line, one action —
// the photograph carries the page, the type sits on it.
import { Picture } from "astro:assets";
import Button from "./Button.astro";
import heroImage from "../assets/voco-by-ihg/hero-1.jpg";
---

<section id="hero" data-hero class="relative h-[100svh] min-h-[560px] w-full overflow-hidden bg-ink text-paper">
  <div id="hero-media" class="absolute inset-0">
    <Picture
      src={heroImage}
      alt="Guest corridor overlooking the atrium at Voco by IHG Al Barsha, a hospitality fitout by Elden"
      formats={["avif", "webp"]}
      widths={[828, 1280, 1920, 2560, 3200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover"
    />
  </div>
  <div class="hero-scrim pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="gutter relative flex h-full flex-col">
    <div id="hero-content" class="flex flex-1 flex-col items-center justify-center pt-[var(--header-h)] text-center">
      <h1 class="text-display">
        <span class="hero-line"><span class="hero-line-inner">Turning Places</span></span>{" "}
        <span class="hero-line"><span class="hero-line-inner">Into <em class="accent">Spaces.</em></span></span>
      </h1>
      <div id="hero-cta" class="mt-[36px] md:mt-[48px]">
        <Button href="/projects" label="View all projects" />
      </div>
    </div>

    <div id="hero-foot" class="meta grid grid-cols-2 items-end gap-[16px] pb-[20px] md:grid-cols-3">
      <a href="/projects/voco-by-ihg" class="cursor-pointer justify-self-start underline-offset-4 hover:underline">
        (01) Voco by IHG — Al Barsha
      </a>
      <span class="hidden justify-self-center md:block" aria-hidden="true">Scroll ↓</span>
      <span class="justify-self-end text-right">Est. 2014 — Dubai, UAE</span>
    </div>
  </div>
</section>

<style>
  /* Three layers of shade, each for a specific piece of type: the top band
     under the header, a soft pool behind the centred headline, and the
     bottom band under the meta row. */
  .hero-scrim {
    background:
      linear-gradient(to bottom, rgb(0 0 0 / 0.5) 0%, rgb(0 0 0 / 0) 24%),
      radial-gradient(ellipse 70% 42% at 50% 50%, rgb(0 0 0 / 0.38), rgb(0 0 0 / 0) 72%),
      linear-gradient(to top, rgb(0 0 0 / 0.55) 0%, rgb(0 0 0 / 0) 26%),
      rgb(0 0 0 / 0.14);
  }

  /* Each line slides up from behind its own mask. Built in the markup, not
     split at runtime — splitWords() would destroy the <em> accent. */
  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.18em;
    margin-bottom: -0.18em;
    /* Same trick sideways: a line that fills its container had the last
       letter's edge shaved off by the mask (the "s" of Places, the italic
       "Spaces."). Pad the mask and pull the padding back off the layout. */
    padding-inline: 0.12em;
    margin-inline: -0.12em;
  }

  .hero-line-inner {
    display: block;
  }

  #hero-media {
    will-change: transform;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { whenVisible } from "../scripts/motion";

  gsap.registerPlugin(ScrollTrigger);

  function initHero() {
    const hero = document.getElementById("hero");
    if (!hero || hero.dataset.init) return;
    hero.dataset.init = "1";
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    whenVisible(() => {
      // Built paused: from() renders its start state immediately, so the
      // headline is already masked when the preloader lifts.
      const intro = gsap
        .timeline({ paused: true })
        .from("#hero-media", { scale: 1.16, duration: 2.2, ease: "power3.out" })
        .from(
          hero.querySelectorAll(".hero-line-inner"),
          { yPercent: 110, duration: 1.1, ease: "power4.out", stagger: 0.12 },
          0.2,
        )
        .from(["#hero-cta", "#hero-foot"], { autoAlpha: 0, y: 16, duration: 0.8, ease: "power2.out", stagger: 0.12 }, 0.75);

      let played = false;
      const play = () => {
        if (played) return;
        played = true;
        intro.play();
      };
      if (document.documentElement.dataset.introReady) play();
      else document.addEventListener("elden:intro", play, { once: true });
      setTimeout(play, 4000);

      // On scroll the photograph lags the page and the headline lifts away.
      const scrub = { trigger: hero, start: "top top", end: "bottom top", scrub: true };
      gsap.to("#hero-media", { yPercent: 16, ease: "none", scrollTrigger: scrub });
      gsap.to("#hero-content", { yPercent: -24, opacity: 0, ease: "none", scrollTrigger: { ...scrub, end: "70% top" } });
    });
  }

  // Direct call as well as the listener: on the first client-side arrival
  // at "/" this module can finish loading after astro:page-load has already
  // fired. The dataset guard stops a normal load from running it twice.
  initHero();
  document.addEventListener("astro:page-load", initHero);
</script>
