---
import Eyebrow from "./Eyebrow.astro";

// 18 client logos in one scrolling row, rendered twice so translateX(-50%)
// loops seamlessly. The supplied marks are white-on-transparent, made for a
// dark canvas like this one.
const logos = Array.from({ length: 18 }, (_, i) => i + 1);

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/clients/*.png", { eager: true });
const getLogo = (n: number) => images[`../assets/clients/${n}.png`]?.default;
// Optional colour-on-hover variant beside each logo.
const getHover = (n: number) => images[`../assets/clients/${n}_hover.png`]?.default;
---

<section class="overflow-hidden py-[96px] md:py-[144px]">
  <div class="gutter flex flex-col gap-[24px] md:flex-row md:items-end md:justify-between">
    <div>
      <Eyebrow>Clients</Eyebrow>
      <h2 class="mt-[20px] text-heading uppercase" data-reveal-words>Trusted by</h2>
    </div>
    <p class="max-w-[34ch] text-body text-muted md:text-right">
      Gym, restaurant, retail, office and hospitality brands we've delivered turnkey fitouts for across the UAE.
    </p>
  </div>

  <div class="marquee-row mt-[56px] overflow-hidden md:mt-[88px]">
    <div class="marquee-track flex w-max items-center">
      {[...logos, ...logos].map((n, i) => {
        const logo = getLogo(n);
        const hover = getHover(n);
        return (
          <div
            class="group relative flex h-[120px] w-[220px] shrink-0 items-center justify-center md:h-[160px] md:w-[300px]"
            aria-hidden={i >= logos.length ? "true" : undefined}
          >
            <img
              src={logo?.src}
              width={logo?.width}
              height={logo?.height}
              alt=""
              class="h-[64px] w-auto object-contain opacity-80 saturate-0 transition-opacity duration-300 group-hover:opacity-0 md:h-[84px]"
              loading="lazy"
            />
            {hover && (
              <img
                src={hover.src}
                width={hover.width}
                height={hover.height}
                alt=""
                class="pointer-events-none absolute h-[64px] w-auto object-contain opacity-0 transition-opacity duration-300 group-hover:opacity-100 md:h-[84px]"
                loading="lazy"
              />
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee 70s linear infinite;
  }
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  /* The hover swap is unusable on a moving target — pause under the pointer. */
  .marquee-row:hover .marquee-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation-play-state: paused;
    }
  }
</style>
