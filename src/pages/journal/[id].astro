---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("journal");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const formatter = new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<Base title={data.title} description={data.excerpt}>
  <article>
    <section class="px-[24px] pt-[48px] md:px-[32px] md:pt-[72px]">
      <div class="mx-auto max-w-[800px]">
        <a href="/journal" class="cursor-pointer text-body text-cream hover:text-[var(--color-brand-green)] hover:underline">&larr; Journal</a>
        <p class="mt-[24px] text-body text-muted">
          {formatter.format(data.date)} &middot; {data.author}
        </p>
        <h1 class="mt-[16px] max-w-[24ch] text-display text-cream">{data.title}</h1>
        {data.tags.length > 0 && (
          <div class="mt-[16px] flex flex-wrap gap-[8px]">
            {data.tags.map((tag: string) => (
              <span class="rounded-full bg-surface px-[14px] py-[6px] text-body text-muted">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Contained and rounded rather than full-bleed 16/9: at full width the
         cover pushed the whole article below the fold and out-shouted the
         headline it was meant to introduce. `rounded-xl` needs no !important
         despite the global `* { border-radius: 0 }` reset — a class beats a
         universal selector on specificity. -->
    <section class="mt-[40px] px-[24px] md:px-[32px]">
      <div class="mx-auto aspect-[16/10] max-w-[880px] overflow-hidden rounded-xl">
        <Picture
          src={data.cover}
          alt={`Cover image for the article “${data.title}”`}
          formats={["avif", "webp"]}
          widths={[600, 900, 1400]}
          sizes="(min-width: 768px) 880px, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </section>

    <section class="px-[24px] py-[96px] md:px-[32px] md:py-[144px]">
      <div class="prose-body mx-auto max-w-[720px] text-cream">
        <Content />
      </div>
    </section>
  </article>
</Base>

<style>
  /* :global() is required here — <Content /> is a separate MDX module, so
     its rendered h2/p/ul/li don't carry this component's Astro scope hash. */
  /* Long-form reading size, deliberately larger than --text-body (16px):
     this column is 720px of continuous prose, not UI chrome, and 16px at
     that measure reads cramped. Line height goes up with it. */
  .prose-body {
    font-size: 1.25rem;
    line-height: 1.6;
  }
  .prose-body :global(p) {
    margin-top: 20px;
  }
  .prose-body :global(p:first-child) {
    margin-top: 0;
  }
  .prose-body :global(h2) {
    margin-top: 64px;
    font-size: var(--text-heading);
    line-height: 1.05;
  }
  .prose-body :global(ul) {
    margin-top: 16px;
    list-style: disc;
    padding-left: 20px;
  }
  .prose-body :global(li) {
    margin-top: 12px;
  }
  .prose-body :global(h3) {
    margin-top: 32px;
    font-size: var(--text-subheading);
    line-height: 1.15;
  }
  .prose-body :global(strong) {
    font-weight: 700;
  }
  /* Comparison tables scroll inside their own box rather than widening the
     article column or the page. */
  .prose-body :global(.table-scroll) {
    margin-top: 24px;
    overflow-x: auto;
  }
  .prose-body :global(table) {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 1rem;
  }
  .prose-body :global(th) {
    text-align: left;
    padding: 12px 16px 12px 0;
    border-bottom: 2px solid var(--color-brand-green);
    font-size: var(--text-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-brand-green);
  }
  .prose-body :global(td) {
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
    color: var(--color-muted);
  }
  .prose-body :global(td:first-child) {
    color: var(--color-cream);
    white-space: nowrap;
  }
</style>
