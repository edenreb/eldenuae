---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("journal");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

const formatter = new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric" });
---

<Base title={data.title} description={data.excerpt}>
  <article>
    <section class="gutter pt-[32px] md:pt-[56px]">
      <div class="flex items-center justify-between gap-[16px]">
        <a href="/journal" class="meta cursor-pointer underline-offset-4 hover:underline">&larr; Journal</a>
        <p class="meta text-right text-muted">
          {formatter.format(data.date)} — {data.author}
        </p>
      </div>
      <h1 class="mt-[48px] max-w-[22ch] text-heading uppercase md:mt-[80px]">{data.title}</h1>
      {data.tags.length > 0 && (
        <ul class="mt-[28px] flex flex-wrap gap-[8px]">
          {data.tags.map((tag: string) => (
            <li class="meta border border-paper/20 px-[10px] py-[6px] text-muted">{tag}</li>
          ))}
        </ul>
      )}
    </section>

    <section class="gutter mt-[40px] md:mt-[64px]">
      <div class="aspect-[4/3] overflow-hidden bg-ink md:aspect-[21/9]">
        <Picture
          src={data.cover}
          alt={`Cover image for the article “${data.title}”`}
          formats={["avif", "webp"]}
          widths={[800, 1400, 2000]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>
    </section>

    <section class="gutter pt-[56px] pb-[120px] md:pt-[96px] md:pb-[200px]">
      <div class="prose-body mx-auto max-w-[720px]">
        <Content />
      </div>
    </section>
  </article>
</Base>

<style>
  /* :global() — <Content /> is a separate MDX module without this
     component's scope hash. Long-form reading size sits a step above UI
     body copy: 720px of continuous prose reads cramped at 17px. */
  .prose-body {
    font-size: 1.1875rem;
    line-height: 1.65;
  }
  .prose-body :global(p) {
    margin-top: 20px;
  }
  .prose-body :global(p:first-child) {
    margin-top: 0;
  }
  .prose-body :global(h2) {
    margin-top: 72px;
    font-size: var(--text-title);
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .prose-body :global(h3) {
    margin-top: 40px;
    font-size: var(--text-lead);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .prose-body :global(ul) {
    margin-top: 16px;
    list-style: square;
    padding-left: 20px;
  }
  .prose-body :global(li) {
    margin-top: 10px;
  }
  .prose-body :global(strong) {
    font-weight: 600;
  }
  .prose-body :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Comparison tables scroll inside their own box rather than widening the
     article column. */
  .prose-body :global(.table-scroll) {
    margin-top: 28px;
    overflow-x: auto;
  }
  .prose-body :global(table) {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 1rem;
  }
  .prose-body :global(th) {
    text-align: left;
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .prose-body :global(td) {
    padding: 12px 16px 12px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--color-paper) 15%, transparent);
    vertical-align: top;
    color: var(--color-muted);
  }
  .prose-body :global(td:first-child) {
    color: var(--color-paper);
    white-space: nowrap;
  }
</style>
