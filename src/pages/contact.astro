---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
import SocialLinks from "../components/SocialLinks.astro";

// This page had a contact form that silently discarded every enquiry (no
// endpoint anywhere in the codebase). Until a real submission target exists
// it sends people to email, which actually delivers. The old form markup is
// in git history at 30c548f.
const MAIL = "info@eldenuae.com";
const MAILTO = `mailto:${MAIL}?subject=${encodeURIComponent("Project enquiry")}&body=${encodeURIComponent(
  "Tell us about the space — sector, location, approximate size, and timeline.\n\n",
)}`;

const details = [
  { label: "General inquiries", value: "info@eldenuae.com", href: "mailto:info@eldenuae.com" },
  { label: "Phone", value: "+971 4 227 6206", href: "tel:+97142276206" },
  { label: "Studio", value: "Dubai, United Arab Emirates" },
];
---

<Base
  title="Contact"
  description="Start a turnkey fitout project with Elden. Get in touch with our Dubai studio."
>
  <section class="gutter pt-[48px] pb-[120px] md:pt-[88px] md:pb-[200px]">
    <Eyebrow>Contact</Eyebrow>
    <h1 class="mt-[28px] text-display uppercase">Let&rsquo;s build <em class="accent">it.</em></h1>

    <div class="mt-[64px] grid grid-cols-1 gap-y-[72px] md:mt-[120px] md:grid-cols-12 md:gap-x-[24px]">
      <div class="md:col-span-5">
        <p class="max-w-[30ch] text-lead">
          Every fitout starts with a conversation. Tell us about the space and we&rsquo;ll come back with next steps
          within one working day.
        </p>
        <p class="mt-[20px] max-w-[42ch] text-body text-muted">
          Send us the sector, location, approximate size and timeline.
        </p>
        <div class="mt-[36px]">
          <Button href={MAILTO} label="Email us" />
        </div>
        {/* A mailto: does nothing without a mail client — keep the address copyable. */}
        <p class="meta mt-[20px] text-muted">
          Or write to <a href={`mailto:${MAIL}`} class="cursor-pointer text-paper normal-case underline underline-offset-4">{MAIL}</a>
        </p>
      </div>

      <dl class="md:col-span-6 md:col-start-7">
        {details.map((d) => (
          <div class="border-t border-paper/15 py-[24px] md:py-[32px]">
            <dt class="meta text-muted">{d.label}</dt>
            <dd class="mt-[12px] text-statement">
              {d.href ? (
                <a href={d.href} class="cursor-pointer break-words underline-offset-[0.12em] hover:underline">
                  {d.value}
                </a>
              ) : (
                d.value
              )}
            </dd>
          </div>
        ))}
        <div class="border-y border-paper/15 py-[24px] md:py-[32px]">
          <dt class="meta text-muted">Follow along</dt>
          <dd class="mt-[12px] text-lead">
            <SocialLinks />
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Base>
