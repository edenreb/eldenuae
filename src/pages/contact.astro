---
import Base from "../layouts/Base.astro";
import SocialLinks from "../components/SocialLinks.astro";

// This page had a full contact form until it was found to be non-functional:
// the <form> carried no action/method, form.ts called preventDefault() and
// then simply hid the form and revealed a "Thanks — that's in." panel. There
// was no fetch and no endpoint anywhere in the codebase, so every enquiry a
// visitor typed was discarded in the browser while they were told it had
// been sent.
//
// Until a real endpoint exists, this route sends people to email instead. A
// mailto is unglamorous, but it actually delivers, and a lost lead costs far
// more than a plainer contact page. Restore the form only alongside a
// working submission target — the markup is in git history at 30c548f.
const MAIL = "info@eldenuae.com";
const MAILTO = `mailto:${MAIL}?subject=${encodeURIComponent("Project enquiry")}&body=${encodeURIComponent(
  "Tell us about the space — sector, location, approximate size, and timeline.\n\n",
)}`;

const details = [
  { label: "General inquiries", value: "info@eldenuae.com", href: "mailto:info@eldenuae.com" },
  { label: "Phone", value: "+971 4 227 6206", href: "tel:+97142276206" },
  { label: "Studio", value: "Dubai, United Arab Emirates" },
];
---

<Base
  title="Contact"
  description="Start a turnkey fitout project with Elden. Get in touch with our Dubai studio."
>
  <!-- Two-row layout, matching the reference: headline and lead-in above,
       details and form below. -->
  <section class="px-[24px] pt-[120px] md:px-[32px] md:pt-[180px]">
    <div class="mx-auto max-w-[1440px]">
      <div class="flex flex-col gap-[24px] md:flex-row md:items-start md:justify-between">
        <h1 class="max-w-[1200px] text-display text-cream">Let&rsquo;s build it.</h1>
        <p class="max-w-[36ch] text-body text-cream md:text-right">
          Every fitout starts with a conversation. Tell us about the space and we&rsquo;ll come back
          with next steps within one working day.
        </p>
      </div>

      <div class="mt-[72px] grid grid-cols-1 gap-[48px] pb-[72px] lg:grid-cols-2 lg:gap-[96px]">
        <div class="flex flex-col gap-[32px]">
          {details.map((d) => (
            <div class="flex flex-col gap-[8px]">
              <p class="text-body text-cream">{d.label}</p>
              {d.href ? (
                <a href={d.href} class="cursor-pointer text-body text-muted hover:text-cream hover:underline">
                  {d.value}
                </a>
              ) : (
                <p class="text-body text-muted">{d.value}</p>
              )}
            </div>
          ))}

          <div class="flex flex-col gap-[8px]">
            <p class="text-body text-cream">Follow along</p>
            <SocialLinks />
          </div>
        </div>

        <div>
          <div class="bg-surface p-[24px] md:p-[32px]">
            <p class="text-subheading text-cream">Tell us about the space.</p>
            <p class="mt-[12px] max-w-[42ch] text-body text-muted">
              Send us the sector, location, approximate size and timeline, and we&rsquo;ll come
              back with next steps within one working day.
            </p>

            <a
              href={MAILTO}
              class="group mt-[24px] inline-flex cursor-pointer items-center gap-[10px] bg-cream px-[16px] py-[8px] text-button text-[var(--color-brand-navy)] transition-[color,opacity] hover:text-ink hover:opacity-90"
            >
              Email us
              <span
                aria-hidden="true"
                class="h-[4px] w-[4px] shrink-0 bg-[var(--color-brand-navy)] transition-colors group-hover:bg-ink"
              ></span>
            </a>

            {/* The address in plain text as well as behind the button — a
                mailto: does nothing on a device with no mail client
                configured, and without this there'd be no way to copy it. */}
            <p class="mt-[16px] text-caption text-muted">
              Or write to{" "}
              <a href={`mailto:${MAIL}`} class="cursor-pointer text-cream underline underline-offset-4">
                {MAIL}
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
