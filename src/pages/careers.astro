---
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import { Picture } from "astro:assets";
import breakImage from "../assets/_misc/careers.jpg";

// mailto, not a form: there is no submission endpoint in this codebase, and
// a form that silently discards a CV is worse than a plain address.
const MAIL = "info@eldenuae.com";

const applyTo = (subject: string, body: string) =>
  `mailto:${MAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

const GENERAL_MAILTO = applyTo(
  "Application — Elden",
  "Tell us which discipline you work in, where you are now, and what you'd want to build here.\n\nAttach a CV and a portfolio (PDF, under 10MB).\n\n",
);

// "Disciplines we hire across", NOT a vacancy list — nothing here records a
// real open position. Swap in real postings when there are any; each row
// already takes a title, a scope line and its own mailto.
const disciplines = [
  { title: "Interior Design", scope: "Concept through to the detail that survives a site meeting." },
  { title: "Technical Detailing", scope: "Drawing packages a joiner can build from without ringing you." },
  { title: "Project Management", scope: "One programme, one budget, from shell to handover." },
  { title: "Site Supervision", scope: "Days on site holding the build to the drawing." },
  { title: "MEP Coordination", scope: "Services routed before they collide with the ceiling." },
  { title: "Procurement", scope: "Long-lead items landing in the country ahead of the programme." },
  { title: "Quantity Surveying", scope: "The numbers we quote being the numbers at handover." },
  { title: "3D Visualisation", scope: "Images a client can sign off on and a crew can build to." },
  { title: "Accounts", scope: "Invoices, payroll and VAT kept straight while the projects run." },
  { title: "Photography", scope: "Finished spaces shot the way they were drawn, before the client moves in." },
];

const reasons = [
  {
    title: "You See It Built.",
    copy: "Design and build sit under one contract here. The detail you draw on Monday is a detail you can stand in front of on site, not one handed to someone else's crew to reinterpret.",
  },
  {
    title: "Small Enough to Be Heard.",
    copy: "Nine years, 87+ projects, one team. There is no layer of account management between the person who solved a problem and the person who briefs the client on it.",
  },
  {
    title: "Real Deadlines.",
    copy: "A fitout finishes when the doors open and the business starts trading. That's a hard date, and it's the most useful teacher in this industry.",
  },
];

const send = [
  "A CV — one page is plenty.",
  "A portfolio as a PDF under 10MB, or a link. Built work first; if it's not built yet, say so.",
  "One line on what you want to be building in two years.",
];
---

<Base
  title="Careers"
  description="Join Elden's Dubai studio. We hire across design, delivery and site — send a portfolio to info@eldenuae.com."
>
  <section class="gutter pt-[48px] md:pt-[88px]">
    <Eyebrow>Careers</Eyebrow>
    <h1 class="mt-[28px] max-w-[14ch] text-display">
      Draw It. Then Go <em class="accent">Build It.</em>
    </h1>
    <div class="mt-[48px] grid grid-cols-1 md:mt-[80px] md:grid-cols-12 md:gap-x-[24px]">
      <div class="md:col-span-6 md:col-start-7">
        <p class="max-w-[40ch] text-lead">
          Most studios hand a drawing over at the site gate and hope. We don&rsquo;t — design and construction are the
          same team here, under one contract. It makes the work harder to hide behind and a great deal more satisfying
          to finish.
        </p>
        <div class="mt-[36px]">
          <Button href={GENERAL_MAILTO} label="Send your portfolio" />
        </div>
      </div>
    </div>
  </section>

  <section class="gutter py-[96px] md:py-[160px]">
    <div class="grid grid-cols-1 gap-y-[48px] sm:grid-cols-3 sm:gap-x-[24px]">
      {reasons.map((r, i) => (
        <div>
          <div class="rule" data-reveal-rule></div>
          <p class="meta mt-[16px] text-muted">({String(i + 1).padStart(2, "0")})</p>
          <h2 class="mt-[28px] text-title">{r.title}</h2>
          <p class="mt-[16px] max-w-[42ch] text-body text-muted">{r.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="gutter">
    <div class="aspect-[4/3] overflow-hidden bg-ink md:aspect-[21/9]" data-reveal>
      <Picture
        src={breakImage}
        alt="Two Elden joinery team members feeding a panel through a sliding table saw in the workshop"
        formats={["avif", "webp"]}
        widths={[800, 1400, 2000, 2600]}
        sizes="100vw"
        loading="lazy"
        class="h-full w-full object-cover object-[70%_20%]"
      />
    </div>
  </section>

  <section class="gutter py-[120px] md:py-[200px]">
    <div class="flex flex-col gap-[24px] md:flex-row md:items-end md:justify-between">
      <div>
        <Eyebrow>Where we hire</Eyebrow>
        <h2 class="mt-[20px] max-w-[18ch] text-heading">
          We Don&rsquo;t Keep a Vacancy List. Write Anyway.
        </h2>
      </div>
      <p class="max-w-[42ch] text-body text-muted md:text-right">
        Openings here tend to appear with a project rather than a hiring round, so the useful thing is for us to
        already have your work on file. These are the disciplines we hire across — pick the closest one.
      </p>
    </div>

    <!-- Each row is its own mailto: the prefilled subject is what makes a
         speculative application filterable on the receiving end. -->
    <ul class="mt-[56px] md:mt-[96px]">
      {disciplines.map((d, i) => (
        <li class="border-t border-paper/15 last:border-b">
          <a
            href={applyTo(
              `Application — ${d.title}`,
              `I'd like to be considered for ${d.title.toLowerCase()} work at Elden.\n\nWhere I am now:\nWhat I've built:\n\nCV and portfolio attached.\n\n`,
            )}
            class="group grid cursor-pointer grid-cols-[1fr_auto] items-baseline gap-x-[16px] gap-y-[8px] py-[24px] md:grid-cols-12 md:gap-x-[24px] md:py-[28px]"
          >
            <span class="meta hidden text-muted md:col-span-1 md:block">({String(i + 1).padStart(2, "0")})</span>
            <span class="text-title md:col-span-4">{d.title}</span>
            <span class="meta self-center text-muted transition-colors group-hover:text-paper md:order-last md:col-span-2 md:justify-self-end">
              Apply &#8599;
            </span>
            <span class="col-span-2 text-body text-muted md:col-span-5">{d.scope}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="gutter pb-[120px] md:pb-[200px]">
    <div class="grid grid-cols-1 gap-y-[56px] md:grid-cols-12 md:gap-x-[24px]">
      <div class="md:col-span-5">
        <Eyebrow>What to send</Eyebrow>
        <h2 class="mt-[20px] max-w-[16ch] text-heading">
          Three Things, and We&rsquo;ll Read All of Them.
        </h2>
        <ol class="mt-[40px]">
          {send.map((s, i) => (
            <li class="flex gap-[16px] border-t border-paper/15 py-[18px] text-body last:border-b">
              <span class="meta mt-[4px] text-muted">({String(i + 1).padStart(2, "0")})</span>
              <span>{s}</span>
            </li>
          ))}
        </ol>
        <p class="mt-[24px] max-w-[46ch] text-body text-muted">
          Every application is read by the people you&rsquo;d actually work with. If the work fits something we have
          coming, you&rsquo;ll hear from us — and if it doesn&rsquo;t, we keep it on file rather than deleting it.
        </p>
      </div>

      <div class="self-start border border-paper/15 p-[28px] md:col-span-6 md:col-start-7 md:p-[48px]">
        <p class="text-heading">Send It to the Studio.</p>
        <p class="mt-[20px] max-w-[42ch] text-body text-muted">
          One address, straight to the Dubai studio. Applications, internships and speculative introductions all go to
          the same place.
        </p>
        <div class="mt-[36px]">
          <Button href={GENERAL_MAILTO} label="Email your application" />
        </div>
        <p class="meta mt-[20px] text-muted">
          Or write to <a href={`mailto:${MAIL}`} class="cursor-pointer text-paper normal-case underline underline-offset-4">{MAIL}</a>
        </p>
      </div>
    </div>
  </section>
</Base>
