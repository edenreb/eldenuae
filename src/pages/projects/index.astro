---
import Base from "../../layouts/Base.astro";
import { PROJECTS } from "../../facts";
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import { cellStyles } from "../../scripts/mosaic";

// Ordered by how much of the job was ours, widest first, then newest first
// inside each band. The scope strings in the content vary in wording
// ("MEP" / "MEP Works", four spellings of fitout), so match on keywords.
const SCOPE_BANDS = [
  // Turnkey: the whole interior, or design and build together.
  (s: string) => /complete|full/.test(s) || (/design/.test(s) && /fit-?out/.test(s)),
  (s: string) => /fit-?out/.test(s) && /\bmep\b/.test(s),
  (s: string) => /fit-?out/.test(s),
  (s: string) => /joinery/.test(s),
];
const band = (scope: string[]) => {
  const s = scope.join(" ").toLowerCase();
  const i = SCOPE_BANDS.findIndex((match) => match(s));
  return i === -1 ? SCOPE_BANDS.length : i; // services only (MEP) last
};

const projects = (await getCollection("projects")).sort(
  (a, b) => band(a.data.scope) - band(b.data.scope) || b.data.year - a.data.year,
);

const sectors = ["All", ...new Set(projects.map((p) => p.data.sector))];
const countFor = (sector: string) =>
  sector === "All" ? projects.length : projects.filter((p) => p.data.sector === sector).length;
const styles = cellStyles(projects.length);
---

<Base
  title="Projects"
  description={`${PROJECTS} turnkey fitout projects across the UAE — fitness, F&B, retail, workplace, and hospitality.`}
>
  <h1 class="sr-only">Projects</h1>

  <!-- Sector tabs at display scale, centred; inactive tabs sit back in the
       ghost grey (3.7:1 — passes as large text only, which these always
       are). Styling keys off aria-pressed, so the script only flips state. -->
  <section class="gutter pt-[48px] pb-[40px] md:pt-[88px] md:pb-[64px]">
    <div
      role="group"
      aria-label="Filter by sector"
      class="mx-auto flex max-w-[1280px] flex-wrap items-baseline justify-center gap-x-[0.28em] text-center text-heading"
    >
      {sectors.map((sector, i) => (
        <>
          {i > 0 && <span aria-hidden="true" class="text-ghost">/</span>}
          <button
            type="button"
            data-sector={sector}
            aria-pressed={sector === "All" ? "true" : "false"}
            class="sector-filter cursor-pointer text-ghost transition-colors duration-300 hover:text-paper aria-pressed:text-paper"
          >
            {sector}<sup aria-hidden="true" class="meta ml-[0.2em] align-super">{countFor(sector)}</sup>
          </button>
        </>
      ))}
    </div>
  </section>

  <!-- Mosaic: rows of 3–4 tiles on a 24-column grid with a thin frame gap.
       Row heights and column spans come from src/scripts/mosaic.ts as
       inline custom properties per breakpoint, recomputed over the visible
       tiles after every filter so rows always close flush. -->
  <section class="gutter pt-[12px] pb-[120px] lg:pt-[20px] md:pb-[200px]">
    <div id="project-grid" class="project-grid">
      {projects.map((project, i) => (
        <a
          href={`/projects/${project.id}`}
          data-cursor="open"
          data-sector={project.data.sector}
          data-year={project.data.year}
          style={styles[i]}
          class="project-card group relative block cursor-pointer overflow-hidden bg-ink"
        >
          <Picture
            src={project.data.cover}
            alt={`${project.data.title} — ${project.data.sector.toLowerCase()} fitout by Elden`}
            formats={["avif", "webp"]}
            widths={[500, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 45vw, (min-width: 640px) 60vw, 100vw"
            loading={i < 6 ? "eager" : "lazy"}
            class="h-full w-full scale-[1.14] object-cover transition-[scale] duration-[1200ms] ease-[cubic-bezier(0.2,0.7,0.2,1)] group-hover:scale-[1.2]"
            data-parallax="0.06"
          />
          <div class="card-label pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-[10px] bg-[rgb(6_8_20_/_0.30)] p-[12px] text-center transition-opacity duration-500 md:p-[16px] pointer-fine:bg-[rgb(6_8_20_/_0.26)] pointer-fine:opacity-0 pointer-fine:group-hover:opacity-100 pointer-fine:group-focus-visible:opacity-100">
            <h2 class="text-balance text-[clamp(0.95rem,8.5cqw,2.75rem)] font-bold leading-[1.05] tracking-[-0.02em]">{project.data.title}</h2>
            <p class="meta text-paper">{project.data.sector} — {project.data.year}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    /* Hairline: reads as a frame edge, not a gutter. Flat across breakpoints
       — a "minimal" gap that grows with the viewport stops being minimal. */
    gap: 4px;
  }

  /* Legibility without a heavy wash. The halo rides on the glyphs, so the
     photo keeps its brightness and colour while the text still clears a
     white wall. Three stops: a tight edge, a soft lift, a wide pool. */
  .card-label {
    text-shadow:
      0 1px 2px rgb(6 8 20 / 0.92),
      0 2px 10px rgb(6 8 20 / 0.8),
      0 0 30px rgb(6 8 20 / 0.6);
  }

  .project-card {
    container-type: inline-size;
    grid-column: span var(--span-sm);
    height: calc(var(--h-sm) * 1vw);
  }

  @media (width >= 40rem) {
    .project-card {
      grid-column: span var(--span-md);
      height: calc(var(--h-md) * 1vw);
    }
  }

  @media (width >= 64rem) {
    .project-card {
      grid-column: span var(--span-lg);
      height: calc(var(--h-lg) * 1vw);
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { cellStyles } from "../../scripts/mosaic";

  gsap.registerPlugin(ScrollTrigger);

  function initFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".sector-filter");
    const grid = document.getElementById("project-grid");
    const cards = [...document.querySelectorAll<HTMLAnchorElement>(".project-card")];
    if (!buttons.length || !grid) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // "Develop" reveal, like a photobooth print coming up: each row of tiles
    // fades in from dark and desaturated, left to right.
    const hidden = { opacity: 0, filter: "grayscale(1) brightness(0.4) blur(6px)" };
    const develop = (targets: Element[]) =>
      gsap.to(targets, {
        opacity: 1,
        filter: "grayscale(0) brightness(1) blur(0px)",
        duration: 1.1,
        ease: "power2.out",
        stagger: 0.08,
        clearProps: "opacity,filter",
      });
    if (!reduce) {
      gsap.set(cards, hidden);
      ScrollTrigger.batch(cards, { start: "top 92%", once: true, onEnter: develop });
    }

    let sector = "All";
    const matches = (card: HTMLAnchorElement) => sector === "All" || card.dataset.sector === sector;

    // Show the matches and re-tile them in visible order.
    const layout = () => {
      const visible = cards.filter(matches);
      const styles = cellStyles(visible.length);
      cards.forEach((card) => (card.style.display = "none"));
      visible.forEach((card, i) => {
        card.style.display = "";
        // Property by property, not cssText — GSAP's inline reveal state lives
        // in the same style attribute.
        for (const decl of styles[i].split(";")) {
          const [prop, value] = decl.split(":");
          card.style.setProperty(prop, value);
        }
      });
      // Every tile moved and resized; parallax and reveal triggers re-measure.
      ScrollTrigger.refresh();
    };

    // Cancellable: a second change mid-transition kills the first.
    let current: gsap.core.Timeline | null = null;

    const applyFilter = () => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.sector === sector)));
      current?.kill();

      if (reduce) {
        layout();
        return;
      }

      // The whole mosaic re-tiles, so move it as one: fade out, re-lay while
      // invisible, bring the new set in on a quick stagger.
      current = gsap
        .timeline({ onComplete: () => (current = null) })
        .to(grid, { opacity: 0, duration: 0.22, ease: "power2.in" })
        .add(layout)
        .set(grid, { opacity: 1 })
        .set(cards.filter(matches), hidden)
        .add(() => develop(cards.filter(matches)));
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        sector = btn.dataset.sector ?? "All";
        applyFilter();
      });
    });

    // Deep-link support, e.g. /projects?sector=Fitness
    const requested = new URLSearchParams(location.search).get("sector");
    if (requested && [...buttons].some((b) => b.dataset.sector === requested)) {
      sector = requested;
      applyFilter();
    }
  }

  document.addEventListener("astro:page-load", initFilters);
</script>
