---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import { cellStyles } from "../../scripts/mosaic";

const projects = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year);

const sectors = ["All", ...new Set(projects.map((p) => p.data.sector))];
const countFor = (sector: string) =>
  sector === "All" ? projects.length : projects.filter((p) => p.data.sector === sector).length;
// Only years that actually have a project.
const years = [...new Set(projects.map((p) => p.data.year))].sort((a, b) => b - a);

// Scope strings in the content vary ("MEP" / "MEP Works", four spellings of
// fitout), so the filter groups them into the services the studio sells.
// A project can sit under several.
const SCOPE_GROUPS = [
  ["Design", /design/i],
  ["Fitout", /fit-?out/i],
  ["MEP", /\bmep\b/i],
  ["Joinery", /joinery/i],
  ["FF&E", /ff&e/i],
] as const;
const scopesOf = (scope: string[]): string[] =>
  SCOPE_GROUPS.filter(([, re]) => scope.some((s) => re.test(s))).map(([name]) => name);
const scopes = SCOPE_GROUPS.map(([name]) => name).filter((name) =>
  projects.some((p) => scopesOf(p.data.scope).includes(name)),
);

// Filter bar dropdowns: the site's custom <details> + radios dropdown
// (scripts/dropdown.ts), one "All" option first.
const filters = [
  { name: "scope", label: "Scope", all: "All scopes", options: scopes.map((s) => ({ value: s, label: s })) },
  { name: "year", label: "Year", all: "All years", options: years.map((y) => ({ value: String(y), label: String(y) })) },
];
const countWhere = (name: string, value: string) =>
  projects.filter((p) => (name === "year" ? String(p.data.year) === value : scopesOf(p.data.scope).includes(value)))
    .length;
const styles = cellStyles(projects.length);
---

<Base
  title="Projects"
  description="87+ turnkey fitout projects across the UAE — fitness, F&B, retail, workplace, and hospitality."
>
  <h1 class="sr-only">Projects</h1>

  <!-- Sector tabs at display scale, centred; inactive tabs sit back in the
       ghost grey (3.7:1 — passes as large text only, which these always
       are). Styling keys off aria-pressed, so the script only flips state. -->
  <section class="gutter pt-[48px] pb-[40px] md:pt-[88px] md:pb-[64px]">
    <div
      role="group"
      aria-label="Filter by sector"
      class="mx-auto flex max-w-[1280px] flex-wrap items-baseline justify-center gap-x-[0.28em] text-center text-heading"
    >
      {sectors.map((sector, i) => (
        <>
          {i > 0 && <span aria-hidden="true" class="text-ghost">/</span>}
          <button
            type="button"
            data-sector={sector}
            aria-pressed={sector === "All" ? "true" : "false"}
            class="sector-filter cursor-pointer text-ghost transition-colors duration-300 hover:text-paper aria-pressed:text-paper"
          >
            {sector}<sup aria-hidden="true" class="meta ml-[0.2em] align-super">{countFor(sector)}</sup>
          </button>
        </>
      ))}
    </div>
  </section>

  <div id="filter-bar" class="gutter">
    <div class="rule"></div>
    <div class="flex items-center justify-between gap-[16px] py-[14px]">
      <p id="filter-status" class="meta text-muted" role="status" aria-live="polite">
        {projects.length} projects
      </p>

      <div class="flex items-center gap-[24px] md:gap-[40px]">
        {filters.map((f) => (
          <details data-select class="group relative">
            <summary
              aria-label={`Filter by ${f.name}`}
              class="flex cursor-pointer list-none items-center gap-[10px] py-[6px] text-label uppercase transition-colors hover:text-paper [&::-webkit-details-marker]:hidden"
            >
              <span class="overflow-hidden">
                <span data-value class="block">{f.label}</span>
              </span>
              <svg
                aria-hidden="true"
                viewBox="0 0 12 12"
                class="h-[10px] w-[10px] shrink-0 text-muted transition-transform duration-300 group-open:rotate-180"
              >
                <path d="M2 4.5 6 8.5 10 4.5" fill="none" stroke="currentColor" stroke-width="1.25" />
              </svg>
            </summary>
            <div
              data-options
              role="radiogroup"
              aria-label={`Filter by ${f.name}`}
              class="dropdown absolute right-0 top-[calc(100%+15px)] z-30 w-[240px] border border-paper/15 bg-ink"
            >
              {[{ value: "All", label: f.all }, ...f.options].map((o, i) => (
                <label class="flex cursor-pointer items-center gap-[16px] border-t border-paper/10 px-[20px] py-[14px] text-body text-muted transition-colors first:border-t-0 hover:text-paper has-checked:text-paper has-focus-visible:text-paper has-focus-visible:underline">
                  <input
                    type="radio"
                    name={f.name}
                    value={o.value}
                    checked={i === 0}
                    data-label={i === 0 ? f.label : o.label}
                    class="sr-only"
                  />
                  <span class="flex-1">{o.label}</span>
                  <span class="meta tabular-nums text-ghost">
                    {i === 0 ? projects.length : countWhere(f.name, o.value)}
                  </span>
                  <span aria-hidden="true" data-mark class="h-[7px] w-[7px] shrink-0 bg-brand"></span>
                </label>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>
    <div class="rule"></div>
  </div>

  <!-- Mosaic: rows of 3–4 tiles on a 24-column grid with a thin frame gap.
       Row heights and column spans come from src/scripts/mosaic.ts as
       inline custom properties per breakpoint, recomputed over the visible
       tiles after every filter so rows always close flush. -->
  <section class="gutter pt-[12px] pb-[120px] lg:pt-[20px] md:pb-[200px]">
    <div id="project-grid" class="project-grid">
      {projects.map((project, i) => (
        <a
          href={`/projects/${project.id}`}
          data-cursor="open"
          data-sector={project.data.sector}
          data-year={project.data.year}
          data-scopes={scopesOf(project.data.scope).join("|")}
          style={styles[i]}
          class="project-card group relative block cursor-pointer overflow-hidden bg-ink"
        >
          <Picture
            src={project.data.cover}
            alt={`${project.data.title} — ${project.data.sector.toLowerCase()} fitout by Elden`}
            formats={["avif", "webp"]}
            widths={[500, 800, 1200, 1600]}
            sizes="(min-width: 1024px) 45vw, (min-width: 640px) 60vw, 100vw"
            loading={i < 6 ? "eager" : "lazy"}
            class="h-full w-full scale-[1.14] object-cover transition-[scale] duration-[1200ms] ease-[cubic-bezier(0.2,0.7,0.2,1)] group-hover:scale-[1.2]"
            data-parallax="0.06"
          />
          <div class="pointer-events-none absolute inset-0 flex flex-col justify-end bg-gradient-to-t from-[rgb(6_8_20_/_0.8)] via-[rgb(6_8_20_/_0.1)] via-45% to-transparent p-[12px] transition-colors duration-500 md:p-[16px]">
            <div class="flex items-end justify-between gap-[12px]">
              <h2 class="text-[0.8125rem] leading-[1.15] font-medium md:text-label md:leading-[1.15]">{project.data.title}</h2>
              <span class="meta hidden shrink-0 text-muted sm:inline">{project.data.year}</span>
            </div>
            <p class="meta mt-[6px] hidden text-muted sm:block">{project.data.sector}</p>
          </div>
        </a>
      ))}
    </div>

    <p id="empty-state" hidden class="py-[120px] text-center text-lead text-muted">
      No projects match those filters.
    </p>
  </section>
</Base>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    /* Photobooth-strip margin: enough to read as a frame edge, not a gutter. */
    gap: 12px;
  }

  @media (width >= 64rem) {
    .project-grid {
      gap: 20px;
    }
  }

  .project-card {
    grid-column: span var(--span-sm);
    height: calc(var(--h-sm) * 1vw);
  }

  @media (width >= 40rem) {
    .project-card {
      grid-column: span var(--span-md);
      height: calc(var(--h-md) * 1vw);
    }
  }

  @media (width >= 64rem) {
    .project-card {
      grid-column: span var(--span-lg);
      height: calc(var(--h-lg) * 1vw);
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { cellStyles } from "../../scripts/mosaic";
  import { initDropdowns } from "../../scripts/dropdown";

  gsap.registerPlugin(ScrollTrigger);

  function initFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".sector-filter");
    const bar = document.getElementById("filter-bar");
    const grid = document.getElementById("project-grid");
    const cards = [...document.querySelectorAll<HTMLAnchorElement>(".project-card")];
    const status = document.getElementById("filter-status");
    const empty = document.getElementById("empty-state");
    if (!buttons.length || !bar || !grid) return;
    initDropdowns(bar);
    const picked = (name: string) => bar.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? "All";

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // "Develop" reveal, like a photobooth print coming up: each row of tiles
    // fades in from dark and desaturated, left to right.
    const hidden = { opacity: 0, filter: "grayscale(1) brightness(0.4) blur(6px)" };
    const develop = (targets: Element[]) =>
      gsap.to(targets, {
        opacity: 1,
        filter: "grayscale(0) brightness(1) blur(0px)",
        duration: 1.1,
        ease: "power2.out",
        stagger: 0.08,
        clearProps: "opacity,filter",
      });
    if (!reduce) {
      gsap.set(cards, hidden);
      ScrollTrigger.batch(cards, { start: "top 92%", once: true, onEnter: develop });
    }

    let sector = "All";
    const matches = (card: HTMLAnchorElement) => {
      const year = picked("year");
      const scope = picked("scope");
      return (
        (sector === "All" || card.dataset.sector === sector) &&
        (year === "All" || card.dataset.year === year) &&
        (scope === "All" || card.dataset.scopes!.split("|").includes(scope))
      );
    };

    // Show the matches and re-tile them in visible order.
    const layout = () => {
      const visible = cards.filter(matches);
      const styles = cellStyles(visible.length);
      cards.forEach((card) => (card.style.display = "none"));
      visible.forEach((card, i) => {
        card.style.display = "";
        // Property by property, not cssText — GSAP's inline reveal state lives
        // in the same style attribute.
        for (const decl of styles[i].split(";")) {
          const [prop, value] = decl.split(":");
          card.style.setProperty(prop, value);
        }
      });
      if (status) status.textContent = `${visible.length} project${visible.length === 1 ? "" : "s"}`;
      if (empty) empty.hidden = visible.length > 0;
      // Every tile moved and resized; parallax and reveal triggers re-measure.
      ScrollTrigger.refresh();
    };

    // Cancellable: a second change mid-transition kills the first.
    let current: gsap.core.Timeline | null = null;

    const applyFilter = () => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.sector === sector)));
      current?.kill();

      if (reduce) {
        layout();
        return;
      }

      // The whole mosaic re-tiles, so move it as one: fade out, re-lay while
      // invisible, bring the new set in on a quick stagger.
      current = gsap
        .timeline({ onComplete: () => (current = null) })
        .to(grid, { opacity: 0, duration: 0.22, ease: "power2.in" })
        .add(layout)
        .set(grid, { opacity: 1 })
        .set(cards.filter(matches), hidden)
        .add(() => develop(cards.filter(matches)));
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        sector = btn.dataset.sector ?? "All";
        applyFilter();
      });
    });
    bar.addEventListener("change", applyFilter);

    // Deep-link support, e.g. /projects?sector=Fitness
    const requested = new URLSearchParams(location.search).get("sector");
    if (requested && [...buttons].some((b) => b.dataset.sector === requested)) {
      sector = requested;
      applyFilter();
    }
  }

  document.addEventListener("astro:page-load", initFilters);
</script>
