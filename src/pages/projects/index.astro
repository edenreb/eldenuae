---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

const projects = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year);

const sectors = ["All", ...new Set(projects.map((p) => p.data.sector))];
const countFor = (sector: string) =>
  sector === "All" ? projects.length : projects.filter((p) => p.data.sector === sector).length;
// Only years that actually have a project.
const years = [...new Set(projects.map((p) => p.data.year))].sort((a, b) => b - a);
---

<Base
  title="Projects"
  description="87+ turnkey fitout projects across the UAE — fitness, F&B, retail, workplace, hospitality, and wellness."
>
  <h1 class="sr-only">Projects</h1>

  <!-- Sector tabs at display scale, centred; inactive tabs sit back in the
       ghost grey (3.3:1 — passes as large text only, which these always
       are). Styling keys off aria-pressed, so the script only flips state. -->
  <section class="gutter pt-[48px] pb-[40px] md:pt-[88px] md:pb-[64px]">
    <div
      role="group"
      aria-label="Filter by sector"
      class="mx-auto flex max-w-[1280px] flex-wrap items-baseline justify-center gap-x-[0.28em] text-center text-heading uppercase"
    >
      {sectors.map((sector, i) => (
        <>
          {i > 0 && <span aria-hidden="true" class="text-ghost">/</span>}
          <button
            type="button"
            data-sector={sector}
            aria-pressed={sector === "All" ? "true" : "false"}
            class="sector-filter cursor-pointer text-ghost uppercase transition-colors duration-300 hover:text-ink aria-pressed:text-ink"
          >
            {sector}<sup aria-hidden="true" class="meta ml-[0.2em] align-super">{countFor(sector)}</sup>
          </button>
        </>
      ))}
    </div>
  </section>

  <div class="gutter">
    <div class="rule"></div>
    <div class="flex items-center justify-between gap-[16px] py-[14px]">
      <p id="filter-status" class="meta text-muted" role="status" aria-live="polite">
        {projects.length} projects
      </p>

      <div class="flex items-center gap-[32px]">
        <label class="relative flex items-center">
          <span class="sr-only">Filter by year</span>
          <select id="year-filter" class="cursor-pointer appearance-none bg-transparent pr-[22px] text-label uppercase">
            <option value="All">Year</option>
            {years.map((year) => <option value={year}>{year}</option>)}
          </select>
          <span aria-hidden="true" class="pointer-events-none absolute right-0 text-[9px]">&#9660;</span>
        </label>

        <div role="group" aria-label="Grid density" class="hidden items-center gap-[14px] text-label lg:flex">
          <button type="button" data-cols="2" aria-label="2 columns" aria-pressed="false" class="col-toggle cursor-pointer text-ghost hover:text-ink aria-pressed:text-ink">2</button>
          <button type="button" data-cols="4" aria-label="4 columns" aria-pressed="true" class="col-toggle cursor-pointer text-ghost hover:text-ink aria-pressed:text-ink">4</button>
        </div>
      </div>
    </div>
    <div class="rule"></div>
  </div>

  <section class="gutter pt-[16px] pb-[120px] md:pb-[200px]">
    <div id="project-grid" data-cols="4" class="project-grid grid grid-cols-1 gap-x-[16px] gap-y-[40px] sm:grid-cols-2 lg:gap-y-[16px]">
      {projects.map((project, i) => (
        <a
          href={`/projects/${project.id}`}
          data-cursor="open"
          data-sector={project.data.sector}
          data-year={project.data.year}
          class="project-card group block cursor-pointer"
        >
          <div class="card-media relative overflow-hidden bg-ink">
            <Picture
              src={project.data.cover}
              alt={`${project.data.title} — ${project.data.sector.toLowerCase()} fitout by Elden`}
              formats={["avif", "webp"]}
              widths={[500, 800, 1200]}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
              loading={i < 4 ? "eager" : "lazy"}
              class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.2,0.7,0.2,1)] group-hover:scale-[1.05]"
            />
            {/* Hover title, pointer-fine only — a touch device gets the
                caption below instead, so only one of the two is ever
                rendered (and read). */}
            <div class="pointer-events-none absolute inset-0 hidden flex-col items-center justify-end bg-gradient-to-t from-black/75 via-black/15 to-transparent p-[24px] text-center text-paper opacity-0 transition-opacity duration-500 group-hover:opacity-100 group-focus-visible:opacity-100 pointer-fine:flex">
              <h2 class="text-title uppercase">{project.data.title}</h2>
              <p class="meta mt-[10px]">{project.data.location}</p>
            </div>
          </div>
          <div class="pointer-fine:hidden">
            <div class="mt-[12px] flex items-baseline justify-between gap-[12px]">
              <h2 class="text-label uppercase">{project.data.title}</h2>
              <span class="meta shrink-0 text-muted">{project.data.year}</span>
            </div>
            <p class="meta mt-[6px] text-muted">{project.data.sector} — {project.data.location}</p>
          </div>
        </a>
      ))}
    </div>

    <p id="empty-state" hidden class="py-[120px] text-center text-lead text-muted">
      No projects match that sector and year.
    </p>
  </section>
</Base>

<style>
  .card-media {
    aspect-ratio: 3 / 4;
  }

  @media (width >= 64rem) {
    .project-grid[data-cols="4"] {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .project-grid[data-cols="2"] .card-media {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  import gsap from "gsap";

  function initFilters() {
    const buttons = document.querySelectorAll<HTMLButtonElement>(".sector-filter");
    const yearSelect = document.getElementById("year-filter") as HTMLSelectElement | null;
    const grid = document.getElementById("project-grid");
    const cards = document.querySelectorAll<HTMLAnchorElement>(".project-card");
    const status = document.getElementById("filter-status");
    const empty = document.getElementById("empty-state");
    if (!buttons.length || !yearSelect || !grid) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let sector = "All";
    const matches = (card: HTMLAnchorElement) =>
      (sector === "All" || card.dataset.sector === sector) &&
      (yearSelect.value === "All" || card.dataset.year === yearSelect.value);

    // Cancellable: a second change before the first animation finishes
    // kills it and starts clean rather than fighting over `display`.
    let current: gsap.core.Timeline | null = null;

    const applyFilter = () => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.sector === sector)));

      const showing: HTMLAnchorElement[] = [];
      const hiding: HTMLAnchorElement[] = [];
      cards.forEach((card) => {
        const match = matches(card);
        const wasHidden = card.style.display === "none";
        if (match && wasHidden) showing.push(card);
        else if (!match && !wasHidden) hiding.push(card);
      });

      const visible = [...cards].filter(matches).length;
      if (status) status.textContent = `${visible} project${visible === 1 ? "" : "s"}`;
      if (empty) empty.hidden = visible > 0;

      current?.kill();
      if (reduce || (!showing.length && !hiding.length)) {
        cards.forEach((card) => {
          card.style.display = matches(card) ? "" : "none";
          gsap.set(card, { clearProps: "opacity,scale" });
        });
        return;
      }

      const tl = gsap.timeline({ onComplete: () => (current = null) });
      current = tl;
      if (hiding.length) {
        tl.to(hiding, { opacity: 0, scale: 0.97, duration: 0.22, ease: "power2.in", stagger: 0.012 });
      }
      tl.set(hiding, { display: "none" });
      tl.set(showing, { display: "", opacity: 0, scale: 0.97 });
      if (showing.length) {
        tl.to(showing, { opacity: 1, scale: 1, duration: 0.35, ease: "power2.out", stagger: 0.025 });
      }
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        sector = btn.dataset.sector ?? "All";
        applyFilter();
      });
    });
    yearSelect.addEventListener("change", applyFilter);

    document.querySelectorAll<HTMLButtonElement>(".col-toggle").forEach((btn, _, all) => {
      btn.addEventListener("click", () => {
        grid.dataset.cols = btn.dataset.cols;
        all.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      });
    });

    // Deep-link support, e.g. /projects?sector=Fitness
    const requested = new URLSearchParams(location.search).get("sector");
    if (requested && [...buttons].some((b) => b.dataset.sector === requested)) {
      sector = requested;
      applyFilter();
    }
  }

  document.addEventListener("astro:page-load", initFilters);
</script>
