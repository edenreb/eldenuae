---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { Picture } from "astro:assets";
import Eyebrow from "../../components/Eyebrow.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project, allProjects: projects },
  }));
}

const { project, allProjects } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const currentIndex = allProjects.findIndex((p) => p.id === project.id);
const nextIndex = (currentIndex + 1) % allProjects.length;
const nextProject = allProjects[nextIndex];
const pad = (n: number) => String(n).padStart(2, "0");

const restOfGallery = data.gallery.slice(1);
const last = restOfGallery.length - 1;
// Rhythm: one full-width frame, then a pair. A pair left with one frame
// runs full width instead of sitting alone at half.
const isFull = (i: number) => i % 3 === 0 || (i % 3 === 1 && i === last);

const facts = [
  { label: "Client", value: data.client },
  { label: "Year", value: String(data.year) },
  { label: "Location", value: data.location },
  { label: "Scope", value: data.scope.join(", ") },
];
---

<Base title={data.title} description={data.summary}>
  <section class="gutter pt-[32px] md:pt-[56px]">
    <div class="flex items-center justify-between gap-[16px]">
      <a href="/projects" class="meta cursor-pointer underline-offset-4 hover:underline">&larr; All projects</a>
      <p class="meta text-muted">{data.sector} — {data.year}</p>
    </div>
    <h1 class="mt-[48px] max-w-[14ch] text-display md:mt-[80px]">{data.title}</h1>
  </section>

  <section class="gutter mt-[40px] md:mt-[72px]">
    <div class="aspect-[4/3] overflow-hidden bg-ink md:aspect-[21/9]">
      <Picture
        src={data.cover}
        alt={`${data.title} — ${data.sector.toLowerCase()} fitout by Elden`}
        formats={["avif", "webp"]}
        widths={[800, 1400, 2000, 2600]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="h-full w-full object-cover"
        data-settle
      />
    </div>
  </section>

  <section class="gutter py-[72px] md:py-[140px]">
    <div class="grid grid-cols-1 gap-y-[56px] md:grid-cols-12 md:gap-x-[24px]">
      <dl class="grid content-start grid-cols-2 gap-x-[24px] gap-y-[28px] md:col-span-4 md:grid-cols-1">
        {facts.map((fact) => (
          <div>
            <div class="rule" data-reveal-rule></div>
            <dt class="meta mt-[12px] text-muted">{fact.label}</dt>
            <dd class="mt-[6px] text-body">{fact.value}</dd>
          </div>
        ))}
      </dl>

      <div class="md:col-span-7 md:col-start-6">
        <p class="text-statement">{data.summary}</p>
        <div class="prose-body mt-[32px] max-w-[62ch] text-body text-muted">
          <Content />
        </div>
      </div>
    </div>
  </section>

  {restOfGallery.length > 0 && (
    <section class="gutter pb-[120px] md:pb-[200px]">
      <div class="grid grid-cols-1 gap-[16px] md:grid-cols-2">
        {restOfGallery.map((img, i) => (
          <div class:list={["overflow-hidden bg-ink", isFull(i) ? "aspect-[4/3] md:col-span-2 md:aspect-[16/9]" : "aspect-[4/3]"]} data-reveal>
            <Picture
              src={img}
              alt={`${data.title} — interior detail`}
              formats={["avif", "webp"]}
              widths={[600, 1000, 1600, 2400]}
              sizes={isFull(i) ? "100vw" : "(min-width: 768px) 50vw, 100vw"}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Next project: a compact index card, not a second hero. The cover sits
       inset in its frame and opens to full bleed on hover while the title
       nudges and the arrow tile slides out — one gesture, three responses. -->
  <section class="gutter pb-[72px] md:pb-[120px]">
    <div class="flex items-center justify-between gap-[16px]">
      <Eyebrow>Next project</Eyebrow>
      <p class="meta text-muted">{pad(nextIndex + 1)} / {pad(allProjects.length)}</p>
    </div>
    <div class="rule mt-[16px]" data-reveal-rule></div>

    <a
      href={`/projects/${nextProject.id}`}
      data-cursor="open"
      class="group mt-[24px] grid cursor-pointer grid-cols-1 gap-[20px] md:mt-[32px] md:grid-cols-12 md:items-stretch md:gap-x-[24px]"
    >
      <div class="flex flex-col justify-between gap-[24px] md:col-span-4">
        <div>
          <p class="meta text-muted">{nextProject.data.sector}</p>
          <p class="mt-[12px] max-w-[18ch] text-lead transition-transform duration-500 ease-[cubic-bezier(0.2,0.7,0.2,1)] md:group-hover:translate-x-[8px]">
            {nextProject.data.title}
          </p>
        </div>
        <div class="flex items-end justify-between gap-[16px]">
          <p class="meta text-muted">{nextProject.data.location} · {nextProject.data.year}</p>
          <span
            aria-hidden="true"
            class="relative flex h-[44px] w-[44px] shrink-0 items-center justify-center overflow-hidden border border-paper/25 transition-colors duration-300 group-hover:border-paper group-hover:bg-paper group-hover:text-ink"
          >
            <span class="transition-transform duration-500 ease-[cubic-bezier(0.2,0.7,0.2,1)] group-hover:translate-x-[44px]">&rarr;</span>
            <span class="absolute -translate-x-[44px] transition-transform duration-500 ease-[cubic-bezier(0.2,0.7,0.2,1)] group-hover:translate-x-0">&rarr;</span>
          </span>
        </div>
      </div>

      <div class="aspect-[16/9] overflow-hidden bg-ink [clip-path:inset(0)] md:col-span-8 md:aspect-[21/9] md:[clip-path:inset(6%_4%)] md:transition-[clip-path] md:duration-[900ms] md:ease-[cubic-bezier(0.2,0.7,0.2,1)] md:group-hover:[clip-path:inset(0)]">
        <Picture
          src={nextProject.data.cover}
          alt=""
          formats={["avif", "webp"]}
          widths={[600, 1000, 1600]}
          sizes="(min-width: 768px) 66vw, 100vw"
          loading="lazy"
          class="h-full w-full object-cover md:scale-[1.08] md:transition-transform md:duration-[900ms] md:ease-[cubic-bezier(0.2,0.7,0.2,1)] md:group-hover:scale-100"
        />
      </div>
    </a>
  </section>
</Base>

<style>
  /* :global() — <Content /> is a separate markdown module without this
     component's scope hash. */
  .prose-body :global(p + p) {
    margin-top: 16px;
  }
</style>
