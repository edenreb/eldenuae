---
// PLACEHOLDER LEGAL COPY — not reviewed by a lawyer and not compliant advice.
// This page exists so the footer's privacy link resolves to something real
// rather than a dead "#". Elden must replace the entire body with policy text
// prepared for their jurisdiction before launch.
import Base from "../layouts/Base.astro";
---

<Base title="Privacy policy" description="How Elden collects, uses, and stores information submitted through this website.">
  <section class="px-[24px] pt-[48px] md:px-[32px] md:pt-[72px]">
    <div class="mx-auto max-w-[1440px]">
      <h1 class="text-display text-cream">Privacy policy.</h1>
    </div>
  </section>

  <section class="px-[24px] py-[96px] md:px-[32px] md:py-[144px]">
    <div class="mx-auto max-w-[640px] text-body text-cream">
      <p class="border border-line bg-surface p-[16px]">
        <strong>Placeholder.</strong> This page is a structural placeholder so the site has no dead links.
        It is not legal advice and has not been reviewed. Replace it with a policy prepared for the UAE
        before launch.
      </p>

      <h2 class="mt-[32px] text-subheading">What we collect</h2>
      <p class="mt-[12px]">
        The enquiry and application forms on this site collect the name, email address, phone number,
        and any message or file you choose to submit.
      </p>

      <h2 class="mt-[32px] text-subheading">How we use it</h2>
      <p class="mt-[12px]">
        Submitted details are used to respond to your enquiry or application. They are not sold, and are
        not shared with third parties except where needed to deliver a project you have engaged us for.
      </p>

      <h2 class="mt-[32px] text-subheading">Retention</h2>
      <p class="mt-[12px]">
        Enquiries and applications are kept on file so we can contact you about current and future work.
        Write to us to have your details removed.
      </p>

      <h2 class="mt-[32px] text-subheading">Contact</h2>
      <p class="mt-[12px]">
        Questions about this policy can be sent to
        <a href="mailto:info@eldenuae.com" class="cursor-pointer underline underline-offset-4">info@eldenuae.com</a>.
      </p>
    </div>
  </section>
</Base>
