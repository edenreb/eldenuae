---
// Written against what the site actually does: the form fields in
// scripts/enquiry.ts, email delivery through Resend (worker.ts), hosting and
// request logs on Cloudflare (wrangler.jsonc), no cookies or analytics, one
// sessionStorage flag for the intro (Base.astro). Update it when any of that
// changes.
import Base from "../layouts/Base.astro";

const UPDATED = "26 September 2026";
const MAIL = "info@eldenuae.com";

const sections = [
  {
    title: "Who We Are",
    body: [
      `Elden is an interior design, fitout and MEP contractor based in Dubai, United Arab Emirates. We are responsible for the personal data described in this policy. For anything relating to it, contact us at ${MAIL}.`,
    ],
  },
  {
    title: "What We Collect",
    body: [
      "We only collect what you send us. When you use the enquiry form we receive your name, email address, phone number and country code, the type of enquiry, and the details you enter for it: for a project, the company, sector, location, size, timeline, budget, services and message; for a supplier enquiry, the company, trade, website and message; for a job application, the role, a portfolio or LinkedIn link, your message and the CV you attach.",
      "If you email, call or message us on WhatsApp, we receive whatever you choose to include.",
      "Like any website, our hosting provider records technical request data, such as your IP address, browser and the pages requested, to keep the site running and secure.",
    ],
  },
  {
    title: "How We Use It",
    body: [
      "We use your details to reply to your enquiry, prepare proposals, assess job applications, and work with suppliers and subcontractors. We do not use them for marketing unless you ask us to, and we never sell them.",
    ],
  },
  {
    title: "Cookies and Tracking",
    body: [
      "This site sets no cookies and runs no analytics, advertising or tracking scripts. Fonts are served from our own domain. Your browser stores a single session flag so the opening animation plays once per visit; it holds no personal data and is cleared when you close the tab.",
    ],
  },
  {
    title: "Who We Share It With",
    body: [
      "Form submissions are delivered to our inbox by Resend, an email delivery service, and the site is hosted on Cloudflare. Both process data on our behalf and may do so on servers outside the UAE; we use them only under terms that protect it. Links to WhatsApp, Instagram or other platforms take you to services governed by their own privacy policies.",
      "We may also disclose information where the law requires it.",
    ],
  },
  {
    title: "How Long We Keep It",
    body: [
      "Enquiries are kept for up to two years after our last contact, or longer if they become part of a project we deliver for you. Job applications and CVs are kept for up to twelve months so we can consider you for other roles, unless you ask us to delete them sooner.",
    ],
  },
  {
    title: "Your Rights",
    body: [
      `Under the UAE Personal Data Protection Law you can ask to access, correct or delete the personal data we hold about you, to restrict or object to how we use it, and to receive a copy of it. Email ${MAIL} and we will respond within 30 days.`,
    ],
  },
  {
    title: "Changes",
    body: ["If we change how we handle personal data, we will update this page and the date below."],
  },
];
---

<Base title="Privacy policy" description="How Elden collects, uses, and stores information submitted through this website.">
  <section class="gutter pt-[48px] md:pt-[88px]">
    <h1 class="max-w-[12ch] text-display">Privacy Policy</h1>
  </section>

  <section class="gutter py-[72px] md:py-[120px]">
    <div class="mx-auto max-w-[680px] text-body md:ml-[calc(100%/12*5)]">
      <p class="meta text-muted">Last updated {UPDATED}</p>

      {sections.map((s) => (
        <>
          <h2 class="mt-[48px] text-title">{s.title}</h2>
          {s.body.map((p) => <p class="mt-[12px]">{p}</p>)}
        </>
      ))}

      <p class="mt-[48px]">
        Questions about this policy:
        <a href={`mailto:${MAIL}`} class="cursor-pointer underline underline-offset-4">{MAIL}</a>.
      </p>
    </div>
  </section>
</Base>
