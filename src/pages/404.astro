---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Eyebrow from "../components/Eyebrow.astro";
---

<Base title="Page not found" description="That page doesn't exist. Find your way back to Elden's work, journal, or studio.">
  <section class="gutter pt-[48px] pb-[120px] md:pt-[88px] md:pb-[200px]">
    <Eyebrow>Error 404</Eyebrow>
    <h1 class="mt-[28px] max-w-[12ch] text-display uppercase">
      This one isn&rsquo;t <em class="accent">built yet.</em>
    </h1>
    <p class="mt-[40px] max-w-[46ch] text-lead">
      The page you asked for doesn&rsquo;t exist &mdash; it may have moved, or the link may be wrong.
    </p>

    <nav aria-label="Recovery links" class="mt-[48px] flex flex-wrap gap-[12px]">
      <Button href="/" label="Back to home" />
      <Button href="/projects" label="See our work" />
      <Button href="/contact" label="Get in touch" />
    </nav>
  </section>
</Base>
