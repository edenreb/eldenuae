---
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/Eyebrow.astro";
import { Picture } from "astro:assets";
import breakImage from "../assets/anantara-penthouse/2.jpg";

const values = [
  {
    title: "Fit-out Works",
    copy: "We provide all types of interior fit-out works for various sectors such as Retail, Hospitality, Restaurants, Commercial and Leisure.",
  },
  {
    title: "Joinery Works",
    copy: "Our Joinery Division is spread across our headquarters in Al Quoz and our joinery facility in Ajman, supported by a skilled team that includes a Head of Joinery along with production supervisors, technicians, painters, carpenters and helpers",
  },
  {
    title: "Civil Works",
    copy: "We offer complete solutions for civil works by undertaking waterproofing, tiling, screeding, block works with plastering and more. We also provide gypsum partition / dry wall systems, glass partition, acoustic partition/ decorative wall cladding in terms of design and build.",
  },
  {
    title: "MEP",
    copy: "Additional to interior fit-out, we also undertake all MEP related works such as design, supply and installation of HVAC, Electrical Works, Plumbing Works, Safety & Fire Installations.",
  },
];
---

<Base
  title="About"
  description="9+ years and 87+ turnkey fitout projects across the UAE. Interior design to handover, one team, one contract."
>
  <section class="px-[24px] pt-[48px] md:px-[32px] md:pt-[72px]">
    <div class="mx-auto max-w-[1440px]">
      <Eyebrow>About Elden</Eyebrow>
      <h1 class="mt-[12px] max-w-[18ch] text-display text-cream">
        The #1 cost-effective Interior Design & Fitout company in the UAE
      </h1>
      <p class="mt-[24px] max-w-[640px] text-body text-cream">
        <!-- PLACEHOLDER COPY: replace with Elden's real founding story before launch -->
        Elden is a well established and prominent company in the Interior Design & Fit-out and MEP field offering a wide range of internal and external services across the UAE.
      </p>
    </div>
  </section>

  <section class="px-[24px] py-[96px] md:px-[32px] md:py-[144px]">
    <div class="mx-auto grid max-w-[1440px] grid-cols-1 gap-[32px] sm:grid-cols-2 lg:grid-cols-4">
      {values.map((v) => (
        <div class="flex flex-col gap-[16px]">
          <div class="rule" data-reveal-rule></div>
          <h2 class="text-subheading text-cream">{v.title}</h2>
          <p class="text-body text-muted">{v.copy}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="aspect-[16/9] w-full overflow-hidden md:aspect-[21/9]">
    <Picture
      src={breakImage}
      alt="Interior detail from an Elden turnkey project"
      formats={["avif", "webp"]}
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading="lazy"
      class="h-full w-full object-cover"
    />
  </section>
</Base>
