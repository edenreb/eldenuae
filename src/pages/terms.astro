---
// PLACEHOLDER LEGAL COPY — not reviewed by a lawyer and not compliant advice.
// Exists so the footer's terms link resolves to something real rather than a
// dead "#". Replace the entire body before launch.
import Base from "../layouts/Base.astro";
---

<Base title="Terms of use" description="The terms that apply to use of the Elden website.">
  <section class="gutter pt-[48px] md:pt-[88px]">
    <h1 class="max-w-[12ch] text-display uppercase">Terms of use</h1>
  </section>

  <section class="gutter py-[72px] md:py-[120px]">
    <div class="mx-auto max-w-[680px] text-body md:ml-[calc(100%/12*5)]">
      <p class="border border-ink/20 p-[20px] text-muted">
        <strong>Placeholder.</strong> This page is a structural placeholder so the site has no dead links.
        It is not legal advice and has not been reviewed. Replace it with terms prepared for the UAE
        before launch.
      </p>

      <h2 class="mt-[48px] text-title uppercase">Use of this site</h2>
      <p class="mt-[12px]">
        This website is provided for information about Elden&rsquo;s services. Content may change without
        notice.
      </p>

      <h2 class="mt-[48px] text-title uppercase">Project imagery</h2>
      <p class="mt-[12px]">
        Photographs of completed projects remain the property of Elden or the respective client and may
        not be reproduced without permission.
      </p>

      <h2 class="mt-[48px] text-title uppercase">Enquiries and quotations</h2>
      <p class="mt-[12px]">
        Nothing on this site constitutes a binding quotation. Scope, cost, and programme are confirmed in
        a signed contract.
      </p>

      <h2 class="mt-[48px] text-title uppercase">Contact</h2>
      <p class="mt-[12px]">
        Questions about these terms can be sent to
        <a href="mailto:info@eldenuae.com" class="cursor-pointer underline underline-offset-4">info@eldenuae.com</a>.
      </p>
    </div>
  </section>
</Base>
