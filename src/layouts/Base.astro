---
import { ClientRouter } from "astro:transitions";
import { Font } from "astro:assets";
import Footer from "../components/Footer.astro";
import Preloader from "../components/Preloader.astro";
import Cursor from "../components/Cursor.astro";
import Logo from "../components/Logo.astro";
import "../styles/global.css";

const links = [
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/journal", label: "Journal" },
  { href: "/careers", label: "Careers" },
  { href: "/contact", label: "Contact" },
];
// Split around the centred wordmark on desktop.
const leftLinks = links.slice(0, 3);
const rightLinks = links.slice(3);

// Astro.url.pathname carries a trailing slash for every static route except
// the root ("/about/", not "/about") — this project's own `links` hrefs
// don't. Normalizing once here is what makes every plain `path === href`
// comparison below actually work; isActive's own `path.startsWith(href+"/")`
// fallback was quietly covering for this same mismatch already.
const path = Astro.url.pathname.replace(/(.)\/$/, "$1");
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
// Stricter than isActive on purpose: isActive's prefix match is right for
// "which nav item looks current" (a journal post should still highlight
// "Journal"), but wrong here — clicking "Journal" while reading a post IS a
// real navigation and should still transition. This only matches the exact
// page a link would otherwise pointlessly re-navigate to.
const isSamePage = (href: string) => path === href;

interface Props {
  title: string;
  description: string;
  // The page opens on a full-bleed [data-hero] image: <main> gets no header
  // offset and the header starts in its light (paper-on-photo) tone.
  heroOverlay?: boolean;
}

const { title, description, heroOverlay = false } = Astro.props;
const pageTitle = title === "Elden" ? title : `${title} — Elden`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-inter-tight" preload />
    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-geist-mono" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    {/* One static social card for every page — one good card beats N
        inconsistent per-page renders. */}
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />

    {/* fallback="swap": the default ("animate") only kicks in for browsers
        without native document.startViewTransition, and it works by
        mutating the LIVE DOM with CSS keyframes rather than freezing a
        snapshot the way native transitions do, so any running animation
        leaks into the crossfade. The swap happens behind the #curtain scrim
        anyway, so an instant "swap" loses nothing. No effect on browsers
        with native support — this prop is only consulted on the fallback
        path. */}
    <ClientRouter fallback="swap" />

    {/* Decides the preloader BEFORE first paint, and must stay inline and
        un-deferred to do it. Preloader.astro's own module script runs on
        `astro:page-load`, which is after the first frame has already been
        painted — so the page flashed into view for a beat and only then got
        covered by the curtain. Nothing renders between this script and the
        curtain now.

        It also owns the scroll lock (`data-preloading`, styled in
        global.css). Previously the wheel drove the page freely behind the
        curtain, so the intro played to nobody and the curtain lifted on
        wherever you'd scrolled to.

        No-JS never gets the attribute, so it never sees a stuck ink
        screen and never gets a locked page — the same contract the `hidden`
        attribute used to provide, minus the flash. */}
    <script is:inline>
      try {
        if (
          !matchMedia("(prefers-reduced-motion: reduce)").matches &&
          !document.hidden &&
          !sessionStorage.getItem("elden:preloaded")
        ) {
          document.documentElement.dataset.preloading = "1";
          // Last-resort backstop. Preloader.astro has its own 8s watchdog,
          // but that watchdog lives INSIDE the module it is insuring — if
          // that chunk never executes (404 after a bad deploy, a throw while
          // importing gsap), nothing ever clears this flag, and the flag
          // alone drives both the full-screen curtain and `overflow: hidden`
          // (see global.css). The page would stay black and unscrollable
          // forever. This timer is armed in the same inline script that
          // creates the risk, so it cannot fail to load. 9s > the module's
          // own 8s watchdog, so in the normal case that one always wins and
          // this never fires.
          setTimeout(function () {
            delete document.documentElement.dataset.preloading;
          }, 9000);
        }
      } catch (e) {
        /* sessionStorage throws outright in some privacy modes — treat that
           as "don't play the intro" rather than taking the page down. */
      }
    </script>
  </head>
  <body>
    <Preloader />
    <Cursor />

    <!-- Page-transition scrim. transition:persist keeps this the SAME DOM
         node across a swap, so it stays opaque while the page changes
         underneath; without it Astro replaces the node mid-fade and the
         replacement renders at its resting opacity 0, uncovering the new
         page early. Empty and aria-hidden — decorative only. -->
    <div id="curtain" aria-hidden="true" transition:persist></div>

    <a
      href="#main-content"
      class="meta fixed left-[16px] top-[12px] -translate-y-24 bg-ink px-[16px] py-[10px] text-paper transition-transform focus:translate-y-0"
      style="z-index: var(--z-skiplink)"
    >
      Skip to main content
    </a>

    <!-- Fixed header: links split either side of a centred wordmark (desktop),
         wordmark + Menu (mobile). data-tone is "light" (bare, straight on the
         photo) while it sits over a full-bleed [data-hero] section and "dark"
         (a navy wash behind it) everywhere else; the script below flips it,
         and slides the header away on scroll-down. -->
    <header
      id="site-header"
      data-tone={heroOverlay ? "light" : "dark"}
      class="site-header gutter fixed inset-x-0 top-0 h-[var(--header-h)]"
      style="z-index: var(--z-nav)"
    >
      <nav aria-label="Primary" class="flex h-full items-center justify-between md:grid md:grid-cols-[1fr_auto_1fr]">
        <ul class="hidden items-center gap-[28px] md:flex">
          {leftLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                data-astro-reload={isSamePage(link.href) ? true : undefined}
                class="nav-link inline-flex items-center text-label uppercase"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <a
          href="/"
          class="flex h-[40px] cursor-pointer items-center"
          data-astro-reload={isSamePage("/") ? true : undefined}
        >
          <Logo class="h-[17px] w-auto md:h-[19px]" label="Elden — home" />
        </a>

        <ul class="hidden items-center gap-[28px] justify-self-end md:flex">
          {rightLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                data-astro-reload={isSamePage(link.href) ? true : undefined}
                class="nav-link inline-flex items-center text-label uppercase"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <button type="button" popovertarget="menu" class="nav-link inline-flex h-[40px] items-center text-label uppercase md:hidden">
          Menu
        </button>
      </nav>
    </header>

    <!-- Mobile menu. Native popover: top layer, Esc and light-dismiss for
         free, no open/close state to manage in JS. -->
    <div id="menu" popover class="gutter bg-ink text-paper">
      <div class="flex h-[var(--header-h)] shrink-0 items-center justify-between">
        <Logo class="h-[17px] w-auto" />
        <button
          type="button"
          popovertarget="menu"
          popovertargetaction="hide"
          class="h-[40px] cursor-pointer text-label uppercase"
        >
          Close
        </button>
      </div>
      <nav aria-label="Menu" class="mt-[10vh]">
        <ul class="flex flex-col gap-[4px]">
          {links.map((link, i) => (
            <li class="flex items-start gap-[12px]">
              <span class="meta mt-[0.6em] text-muted" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                data-astro-reload={isSamePage(link.href) ? true : undefined}
                class:list={[
                  "cursor-pointer text-[clamp(2.75rem,13vw,4.5rem)] font-semibold uppercase leading-[0.95] tracking-[-0.05em]",
                  isActive(link.href) ? "text-brand" : "text-paper",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="meta mt-auto flex flex-col gap-[4px] pb-[calc(24px+env(safe-area-inset-bottom))] text-muted">
        <a href="mailto:info@eldenuae.com" class="cursor-pointer normal-case">info@eldenuae.com</a>
        <a href="tel:+97142276206" class="cursor-pointer">+971 4 227 6206</a>
      </div>
    </div>

    <main id="main-content" tabindex="-1" class:list={[!heroOverlay && "pt-[var(--header-h)]"]}>
      <slot />
    </main>

    <Footer />

    <script>
      import "../scripts/motion";
      import { getLenis } from "../scripts/motion"; // side-effect import above registers astro:page-load listeners

      // Header: tone follows the hero, and the bar slides away on
      // scroll-down / returns on scroll-up. Everything it attaches to window
      // is torn down before the next swap replaces the header node.
      let headerCleanup: (() => void) | null = null;

      function initHeader() {
        headerCleanup?.();
        const header = document.getElementById("site-header");
        const menu = document.getElementById("menu");
        if (!header) return;

        const heroes = document.querySelectorAll("[data-hero]");
        let observer: IntersectionObserver | null = null;
        if (heroes.length) {
          // Light while any full-bleed [data-hero] section sits under the
          // header. The root is shrunk to the top 5% strip of the viewport,
          // i.e. roughly where the header is, in % so it survives resizes.
          const under = new Set<Element>();
          observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => (e.isIntersecting ? under.add(e.target) : under.delete(e.target)));
              header.dataset.tone = under.size ? "light" : "dark";
            },
            { rootMargin: "0px 0px -95% 0px" },
          );
          heroes.forEach((el) => observer!.observe(el));
        }

        let last = window.scrollY;
        const onScroll = () => {
          const y = window.scrollY;
          if (Math.abs(y - last) < 4) return;
          header.toggleAttribute("data-hidden", y > last && y > 160);
          last = y;
        };
        window.addEventListener("scroll", onScroll, { passive: true });

        // Close the menu the moment a link is chosen, rather than leaving it
        // over the curtain for the length of the page fade.
        const onMenuClick = (e: Event) => {
          if ((e.target as Element).closest("a")) menu?.hidePopover();
        };
        menu?.addEventListener("click", onMenuClick);

        headerCleanup = () => {
          observer?.disconnect();
          window.removeEventListener("scroll", onScroll);
          menu?.removeEventListener("click", onMenuClick);
          headerCleanup = null;
        };
      }

      document.addEventListener("astro:page-load", initHeader);
      document.addEventListener("astro:before-swap", () => headerCleanup?.());

      // Page transition: the page fades to its own paper background, the
      // swap happens while the scrim is opaque, then it fades back. A
      // cross-fade between the two pages via the root view-transition
      // pseudos would be a different effect — content dissolving into
      // content — so the fade runs on a scrim above the page instead, and
      // the pseudos stay no-ops.
      //
      // The scrim sits BELOW the nav (see --z-curtain in global.css), so
      // the header stays put while everything under it washes out. That is
      // deliberate: the nav is the one element common to both pages, and
      // holding it still is what stops the transition reading as a full
      // page teardown.
      //
      // 260ms each way, ~520ms plus fetch for a navigation.
      const FADE_MS = 260;
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

      let fading: Animation | null = null;
      // Only fade out after a fade in. astro:page-load also fires on the
      // very first load, where no navigation happened and the scrim is
      // already transparent — without this the page would fade up from paper
      // once on arrival, over the preloader's own intro.
      let navigating = false;

      const curtainEl = () => document.getElementById("curtain");

      const fade = (from: number, to: number) => {
        const el = curtainEl();
        if (!el || reduced.matches) return Promise.resolve();
        fading?.cancel();
        fading = el.animate([{ opacity: from }, { opacity: to }], {
          duration: FADE_MS,
          easing: "ease",
          fill: "forwards",
        });
        // A cancelled animation rejects; that is the expected path when a
        // second navigation interrupts one already in flight.
        return fading.finished.catch(() => {});
      };

      document.addEventListener("astro:before-preparation", (event) => {
        const e = event as unknown as { loader: () => Promise<void> };
        const load = e.loader;
        navigating = true;
        // Astro's documented hook for holding a navigation open: the swap
        // waits on whatever this resolves, so the fetch overlaps the fade
        // and the page is only replaced once the scrim is actually opaque.
        e.loader = async () => {
          await fade(0, 1);
          await load();
        };
      });

      document.addEventListener("astro:after-swap", () => {
        // Belt-and-braces alongside transition:persist — pin the scrim
        // opaque, so a swap that did not preserve the running animation
        // still cannot flash the new page before the fade back.
        if (!navigating || reduced.matches) return;
        const el = curtainEl();
        if (!el) return;
        fading?.cancel();
        el.style.opacity = "1";
      });

      document.addEventListener("astro:page-load", () => {
        if (!navigating) return;
        navigating = false;
        if (reduced.matches) return;
        void fade(1, 0).then(() => {
          // Drop the fill and pin the resting state, so the next navigation
          // starts from a clean 0 rather than from a finished animation
          // holding it there.
          fading?.cancel();
          fading = null;
          const el = curtainEl();
          if (el) el.style.opacity = "0";
        });
      });

      // Force scroll-to-top on every route change, explicitly, rather than
      // trusting the ClientRouter's own default. astro:after-swap is
      // Astro's own recommended event for this — it fires right after the
      // new page's DOM replaces the old one, before the browser paints, so
      // there's no visible jump. Deep-linking to a real in-page anchor
      // (e.g. a future #section link) is the one case this would fight —
      // there are none on this site today, but if that changes, this needs
      // to check location.hash first.
      //
      // window.scrollTo(0, 0) alone isn't enough: Lenis (motion.ts) stays
      // alive across navigations and drives the actual scroll position
      // itself every frame from its own internal target/animated-scroll
      // state, which still holds the OLD page's scroll position right
      // after a swap. Its very next tick calls its own window.scrollTo
      // back toward that stale value, undoing a plain reset — visible
      // site-wide, most obviously on long pages (the journal) where the
      // snap-back distance is largest. Routing the reset through Lenis's
      // own scrollTo (immediate: true, no easing) keeps its internal state
      // in sync instead of fighting it. Still falls back to a plain
      // scrollTo when Lenis isn't running at all (reduced motion).
      //
      // Safari-only follow-up: Lenis's immediate scrollTo bottoms out in
      // `wrapper.scrollTo({ top: 0, behavior: "instant" })` — the
      // options-dict form. Lenis's own internal target/animated-scroll
      // state is updated synchronously either way, so it won't fight this,
      // but Chromium and WebKit disagree on what the options-dict form
      // itself does: Chromium commits the native scroll position the
      // instant the call returns, WebKit schedules it for the next
      // rendering step instead. Anything that reads scroll position
      // synchronously right after this handler runs — the hero's
      // tone observer on arrival is the concrete case — reads the OLD position for one frame in Safari, never in
      // Chrome. `scrollTo(x, y)`, the plain two-argument legacy form,
      // doesn't have that gap in either engine, so it runs unconditionally
      // as a synchronous belt-and-suspenders on top of Lenis's own call
      // rather than being the sole reset only when Lenis is absent.
      document.addEventListener("astro:after-swap", () => {
        const lenis = getLenis();
        if (lenis) lenis.scrollTo(0, { immediate: true });
        window.scrollTo(0, 0);
      });

      // Move focus to main content on route change for screen reader
      // users, but not on the first load of a session (that would steal
      // focus from the URL bar / deep link on arrival). document.referrer
      // isn't a usable signal for this — it reflects the page that linked
      // here from OUTSIDE the site and never updates across the
      // ClientRouter's own client-side transitions, so that check was
      // silently false for every in-app navigation. A plain flag, set
      // after the first load, distinguishes them correctly instead.
      let hasLoaded = false;
      document.addEventListener("astro:page-load", () => {
        if (hasLoaded) {
          const main = document.getElementById("main-content");
          // preventScroll: true — the browser's default focus-into-view
          // behavior would otherwise re-scroll the page on top of the
          // astro:after-swap reset above. Focus itself is what screen
          // readers need; the scroll side-effect was never the intent.
          main?.focus({ preventScroll: true });
        }
        hasLoaded = true;
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    color: var(--color-paper);
    transition:
      transform 0.45s cubic-bezier(0.44, 0, 0.56, 1),
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .site-header[data-tone="dark"] {
    background: color-mix(in srgb, var(--color-ink) 85%, transparent);
    backdrop-filter: blur(12px);
  }

  /* A keyboard user tabbing into a hidden header must see it. */
  .site-header[data-hidden]:not(:focus-within) {
    transform: translateY(-100%);
  }

  /* Underline wipe — grows from the left on hover, stays drawn on the
     current page. No `display` here: this block is unlayered, so it would
     beat Tailwind's layered `md:hidden` on the Menu button. */
  .nav-link {
    position: relative;
    padding-block: 8px;
    cursor: pointer;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 4px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.35s cubic-bezier(0.44, 0, 0.56, 1);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  /* The UA popover box is fit-content and centred; the menu is a full
     sheet. display is only set while open — a plain `display: flex` would
     beat the UA's closed-state `display: none`. */
  #menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    border: 0;
    padding-block: 0;
    opacity: 0;
    transition:
      opacity 0.3s ease,
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
  }

  #menu:popover-open {
    display: flex;
    flex-direction: column;
    opacity: 1;
  }

  @starting-style {
    #menu:popover-open {
      opacity: 0;
    }
  }
</style>
